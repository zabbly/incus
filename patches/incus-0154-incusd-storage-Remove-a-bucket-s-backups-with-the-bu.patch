From 9c4d13238290069464594e6e6ccd50a86e4e0dcd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:04:05 -0500
Subject: [PATCH] incusd/storage: Remove a bucket's backups with the bucket
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This addresses GHSA-8m9x-vx2q-7f9q (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 032065aa79d280a8ff9d9102a9127b93a9f2bf8a)
---
 internal/server/storage/backend.go | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/internal/server/storage/backend.go b/internal/server/storage/backend.go
index e2aae9b36f..4db67c65b1 100644
--- a/internal/server/storage/backend.go
+++ b/internal/server/storage/backend.go
@@ -5190,11 +5190,20 @@ func (b *backend) DeleteBucket(projectName string, bucketName string, op *operat
 		}
 	}
 
-	_ = BucketDBDelete(context.TODO(), b, bucket.ID)
+	err = BucketDBDelete(context.TODO(), b, bucket.ID)
 	if err != nil {
 		return err
 	}
 
+	// Remove the backups directory of the bucket.
+	backupsPath := internalUtil.VarPath("backups", "buckets", b.name, project.StorageBucket(projectName, bucketName))
+	if util.PathExists(backupsPath) {
+		err := os.RemoveAll(backupsPath)
+		if err != nil {
+			return fmt.Errorf("Failed removing bucket backups directory %q: %w", backupsPath, err)
+		}
+	}
+
 	return nil
 }
 
