From 2c030b3a62679018b76636bd5c6126fcec51211f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:37:31 -0500
Subject: [PATCH] incusd/network: Keep long VLAN interface names unique per
 parent
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two parents with the same VLAN ID and long names were given the same
fallback interface name, so the second shared the first's VLAN
interface. Reusing an existing interface now requires it to be that
VLAN on that parent.

This addresses GHSA-fg2p-r659-c4q8 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 01fd19ebfef538e52e390a63e5629c5c03f5ec7c)
---
 internal/server/network/network_utils.go | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/internal/server/network/network_utils.go b/internal/server/network/network_utils.go
index e39ddf06c4..08a7d33736 100644
--- a/internal/server/network/network_utils.go
+++ b/internal/server/network/network_utils.go
@@ -5,6 +5,7 @@ import (
 	"bytes"
 	"context"
 	cryptoRand "crypto/rand"
+	"crypto/sha256"
 	"encoding/hex"
 	"errors"
 	"fmt"
@@ -850,9 +851,10 @@ func GetHostDevice(parent string, vlan string) string {
 	// If no VLANs are configured, use the default pattern.
 	defaultVlan := fmt.Sprintf("%s.%s", parent, vlan)
 
-	// Handle long interface names.
+	// Handle long interface names, keeping the name unique per parent.
 	if len(defaultVlan) > 15 {
-		defaultVlan = fmt.Sprintf("incus-vlan-%s", vlan)
+		parentHash := sha256.Sum256([]byte(parent))
+		defaultVlan = fmt.Sprintf("iv%s-%s", hex.EncodeToString(parentHash[:])[:6], vlan)
 	}
 
 	if !util.PathExists("/proc/net/vlan/config") {
@@ -1158,6 +1160,16 @@ func VLANInterfaceCreate(parent string, vlanDevice string, vlanID string, gvrp b
 	}
 
 	if InterfaceExists(vlanDevice) {
+		// Make sure the existing interface is the VLAN we'd have created.
+		linkInfo, err := ip.LinkByName(vlanDevice)
+		if err != nil {
+			return false, fmt.Errorf("Failed to get link info for %q: %w", vlanDevice, err)
+		}
+
+		if linkInfo.Kind != "vlan" || linkInfo.Parent != parent || strconv.Itoa(linkInfo.VlanID) != vlanID {
+			return false, fmt.Errorf("Interface %q isn't VLAN %q on %q", vlanDevice, vlanID, parent)
+		}
+
 		return false, nil
 	}
 
