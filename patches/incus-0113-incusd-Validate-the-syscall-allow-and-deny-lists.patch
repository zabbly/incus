@@ -1522,6 +1522,13 @@ func (srv *Server) HandleSetxattrSyscall(c Instance, siov *Iovec) int {
 	// int flags
 	args.flags = C.int(siov.req.data.args[4])
 
+	// The policy only intercepts a one byte value.
