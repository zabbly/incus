From fc51ad54d499c69b299404abf854045493d4bd3f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Thu, 19 Nov 2026 17:23:37 -0500
Subject: [PATCH] incusd/storage/btrfs: Confine received subvolumes to the
 volume
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The subvolume paths were only checked lexically, so a symlink shipped in
an earlier subvolume could redirect the removal and move of a later one
outside of the volume.

This addresses GHSA-6g98-m9m8-cggj (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
---
 .../storage/drivers/driver_btrfs_utils.go     | 30 +++++++++++
 .../storage/drivers/driver_btrfs_volumes.go   | 54 +++++++++++++------
 2 files changed, 69 insertions(+), 15 deletions(-)

diff --git a/internal/server/storage/drivers/driver_btrfs_utils.go b/internal/server/storage/drivers/driver_btrfs_utils.go
index 1655e34a32..6f31a3a59f 100644
--- a/internal/server/storage/drivers/driver_btrfs_utils.go
+++ b/internal/server/storage/drivers/driver_btrfs_utils.go
@@ -536,6 +536,36 @@ func (h *BTRFSMetaDataHeader) validate() error {
 	return nil
 }
 
+// subvolumePath returns the location of a subvolume within a volume, refusing symlinks leading outside of it.
+func (d *btrfs) subvolumePath(volPath string, subVolPath string) (string, error) {
+	rel := strings.TrimPrefix(filepath.Clean(subVolPath), string(filepath.Separator))
+	if rel == "" || rel == "." {
+		return volPath, nil
+	}
+
+	root, err := os.OpenRoot(volPath)
+	if err != nil {
+		return "", err
+	}
+
+	defer func() { _ = root.Close() }()
+
+	parent, err := root.Open(filepath.Dir(rel))
+	if err != nil {
+		return "", fmt.Errorf("Invalid subvolume path %q: %w", subVolPath, err)
+	}
+
+	defer func() { _ = parent.Close() }()
+
+	// Get the symlink-free path of the parent directory.
+	parentPath, err := os.Readlink(fmt.Sprintf("/proc/self/fd/%d", parent.Fd()))
+	if err != nil {
+		return "", err
+	}
+
+	return filepath.Join(parentPath, filepath.Base(rel)), nil
+}
+
 // restorationHeader scans the volume and any specified snapshots, returning a header containing subvolume metadata
 // for use in restoring a volume and its snapshots onto another system. The metadata returned represents how the
 // subvolumes should be restored, not necessarily how they are on disk now. Most of the time this is the same,
diff --git a/internal/server/storage/drivers/driver_btrfs_volumes.go b/internal/server/storage/drivers/driver_btrfs_volumes.go
index ac80c9d50c..226aaef746 100644
