From 280bda41f406b7cf2505175bd18512d855aaadc2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:00:32 -0500
Subject: [PATCH] shared/archive: Bound the captured error output
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Everything tar or unsquashfs printed was kept in memory, and the
archive decides how much that is through unknown PAX headers.

This addresses GHSA-3jgx-fpg2-x499 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 73d6115f621da8d839de5b743bd5ea6a09c1a140)
---
 shared/archive/archive.go | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/shared/archive/archive.go b/shared/archive/archive.go
index 417ca15088..4063e96fe3 100644
--- a/shared/archive/archive.go
+++ b/shared/archive/archive.go
@@ -24,8 +24,22 @@ import (
 // RunWrapper is an optional function that's used to wrap rsync, useful for confinement like AppArmor.
 var RunWrapper func(cmd *exec.Cmd, output string, allowedCmds []string) (func(), error)
 
+// maxErrorOutput is how much of a command's error output is kept, the archive controls how much there is.
+const maxErrorOutput = 1024 * 1024
+
+// nullWriteCloser keeps the beginning of a command's error output and drops the rest.
 type nullWriteCloser struct {
-	*bytes.Buffer
+	buffer *bytes.Buffer
+}
+
+// Write keeps up to maxErrorOutput bytes.
+func (nwc *nullWriteCloser) Write(p []byte) (int, error) {
+	remaining := maxErrorOutput - nwc.buffer.Len()
+	if remaining > 0 {
+		nwc.buffer.Write(p[:min(len(p), remaining)])
+	}
+
+	return len(p), nil
 }
 
 // Close closes the writer.
@@ -251,7 +265,7 @@ func Unpack(file string, path string, blockBackend bool, maxMemory int64, tracke
 			}
 
 			stdErr := runError.StdErr().String()
-			if stdErr == "" {
+			if stdErr == "" || len(stdErr) >= maxErrorOutput {
 				return err
 			}
 
