From 87204cfc73bb59117d34044282c6c2a4c143df53 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:08:11 -0500
Subject: [PATCH] incus/image: Check the fingerprint before using it as a file
 name
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The alias target comes from the image server and was used as the
export file name as is, following any symlink found at that name.

This addresses GHSA-5jh2-v77p-jr6q (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
---
 cmd/incus/image.go | 15 +++++++++++++--
 cmd/incus/utils.go | 13 +++++++++++++
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/cmd/incus/image.go b/cmd/incus/image.go
index 71218bac98..c5a7c7a757 100644
--- a/cmd/incus/image.go
+++ b/cmd/incus/image.go
@@ -43,6 +43,9 @@ type imageColumn struct {
 	Data func(api.Image) string
 }
 
+// fingerprintRegexp matches a full or partial image fingerprint.
+var fingerprintRegexp = regexp.MustCompile("^[0-9a-f]{1,64}$")
+
 type cmdImage struct {
 	global *cmdGlobal
 }
@@ -569,26 +572,34 @@ func (c *cmdImageExport) run(cmd *cobra.Command, args []string) error {
 
 	fingerprint := c.image.dereferenceAlias(remoteServer, imageType, imageName)
 
+	// The fingerprint names the local files, don't take a path from the server.
+	if !fingerprintRegexp.MatchString(fingerprint) {
+		return fmt.Errorf(i18n.G("Invalid image fingerprint %q"), fingerprint)
+	}
+
 	// Default target is current directory
 	targetMeta := fingerprint
+	create := createLocalFile
 	if hasTarget {
 		if internalUtil.IsDir(target) {
 			targetMeta = filepath.Join(target, targetMeta)
 		} else {
+			// Only a path picked by the user may be a symlink to somewhere else.
 			targetMeta = target
+			create = os.OpenFile
 		}
 	}
 	targetRootfs := targetMeta + ".root"
 
 	// Prepare the files
-	dest, err := os.Create(targetMeta)
+	dest, err := create(targetMeta, os.O_RDWR|os.O_CREATE|os.O_TRUNC, 0o666)
 	if err != nil {
 		return err
 	}
 
 	defer logger.WarnOnError(dest.Close, "Failed to close file")
 
-	destRootfs, err := os.Create(targetRootfs)
+	destRootfs, err := create(targetRootfs, os.O_RDWR|os.O_CREATE|os.O_TRUNC, 0o666)
 	if err != nil {
 		return err
 	}
diff --git a/cmd/incus/utils.go b/cmd/incus/utils.go
index 2649c7e86b..48347a4b82 100644
--- a/cmd/incus/utils.go
+++ b/cmd/incus/utils.go
@@ -12,6 +12,7 @@ import (
 	"os/exec"
 	"os/signal"
 	"path"
+	"path/filepath"
 	"reflect"
 	"slices"
 	"sort"
@@ -756,6 +757,18 @@ func isStdin(p string) bool {
 	return slices.Contains([]string{"-", "/dev/stdin", "/dev/fd/0"}, p)
 }
 
+// createLocalFile opens a file like os.OpenFile, refusing to follow a symlink out of its directory.
+func createLocalFile(name string, flag int, perm os.FileMode) (*os.File, error) {
+	root, err := os.OpenRoot(filepath.Dir(name))
+	if err != nil {
+		return nil, err
+	}
+
+	defer logger.WarnOnError(root.Close, "Failed to close directory")
+
+	return root.OpenFile(filepath.Base(name), flag, perm)
+}
+
 // isStdout returns whether the provided path looks like stdout.
 func isStdout(p string) bool {
 	return slices.Contains([]string{"-", "/dev/stdout", "/dev/fd/1"}, p)
