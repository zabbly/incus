From 1e57a3145fa88d8e63dd39b126bd48e45d4a03a7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:58:41 -0500
Subject: [PATCH] incusd/project: Refuse overflowing aggregate limit totals
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A single instance or volume set to the maximum int64 wrapped the project
total negative, after which every aggregate limit check passed.

This addresses GHSA-9pvj-5r2h-r873 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit ef70987277cd0b10eeac9f00bced17691bedfe05)
---
 internal/server/project/permissions.go | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/internal/server/project/permissions.go b/internal/server/project/permissions.go
index a2bc11639b..f11c8339b6 100644
--- a/internal/server/project/permissions.go
+++ b/internal/server/project/permissions.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"errors"
 	"fmt"
+	"math"
 	"net/http"
 	"net/url"
 	"path/filepath"
@@ -1820,6 +1821,15 @@ func expandInstancesConfigAndDevices(instances []api.Instance, profiles []api.Pr
 	return expandedInstances, nil
 }
 
+// addLimit adds a value to a running total, refusing an overflow.
+func addLimit(total int64, value int64) (int64, error) {
+	if value < 0 || total > math.MaxInt64-value {
+		return 0, errors.New("Value too large")
+	}
+
+	return total + value, nil
+}
+
 // Sum of the effective values for the given limits across all project
 // entities (instances and custom volumes).
 func getTotalsAcrossProjectEntities(info *projectInfo, keys []string, skipUnset bool) (map[string]int64, error) {
@@ -1853,7 +1863,10 @@ func getTotalsAcrossProjectEntities(info *projectInfo, keys []string, skipUnset
 					return nil, fmt.Errorf(`Parse "size" for custom volume %q in project %q: %w`, volume.Name, info.Project.Name, err)
 				}
 
-				totals[key] += limit
+				totals[key], err = addLimit(totals[key], limit)
+				if err != nil {
+					return nil, fmt.Errorf(`Invalid "size" for custom volume %q in project %q: %w`, volume.Name, info.Project.Name, err)
+				}
 			}
 		}
 	}
@@ -1865,7 +1878,10 @@ func getTotalsAcrossProjectEntities(info *projectInfo, keys []string, skipUnset
 		}
 
 		for _, key := range keys {
-			totals[key] += limits[key]
+			totals[key], err = addLimit(totals[key], limits[key])
+			if err != nil {
+				return nil, fmt.Errorf("Invalid %q for instance %q in project %q: %w", key, inst.Name, inst.Project, err)
+			}
 		}
 	}
 
@@ -1940,7 +1956,10 @@ func getInstanceLimits(inst api.Instance, keys []string, skipUnset bool) (map[st
 					return nil, fmt.Errorf("Failed parsing %q for instance %q in project %q", "size.state", inst.Name, inst.Project)
 				}
 
-				limit += sizeStateLimit
+				limit, err = addLimit(limit, sizeStateLimit)
+				if err != nil {
+					return nil, fmt.Errorf("Invalid %q for instance %q in project %q: %w", "size.state", inst.Name, inst.Project, err)
+				}
 			}
 		} else {
 			// Skip processing for 'limits.processes' if the instance type is VM,
