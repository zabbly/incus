From df2531cffa72625b2f3c755a6f7a5b09c3f44589 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:08:09 -0500
Subject: [PATCH] incusd/profiles: Validate changed devices against instances
 before saving
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A device the instance would refuse made the update fail after the
profile was stored, leaving the instance's recorded limits unapplied.

This addresses GHSA-9pvj-5r2h-r873 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit db9415168487965de75bc036abd7118820ccf8cd)
---
 cmd/incusd/profiles_utils.go | 42 ++++++++++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/cmd/incusd/profiles_utils.go b/cmd/incusd/profiles_utils.go
index 6511513297..beb4ed2b06 100644
--- a/cmd/incusd/profiles_utils.go
+++ b/cmd/incusd/profiles_utils.go
@@ -4,12 +4,14 @@ import (
 	"context"
 	"errors"
 	"fmt"
+	"maps"
 	"slices"
 	"strings"
 
 	internalInstance "github.com/lxc/incus/v7/internal/instance"
 	"github.com/lxc/incus/v7/internal/server/db"
 	"github.com/lxc/incus/v7/internal/server/db/cluster"
+	"github.com/lxc/incus/v7/internal/server/device"
 	deviceConfig "github.com/lxc/incus/v7/internal/server/device/config"
 	"github.com/lxc/incus/v7/internal/server/instance"
 	"github.com/lxc/incus/v7/internal/server/instance/instancetype"
@@ -88,6 +90,46 @@ func doProfileUpdate(ctx context.Context, s *state.State, p api.Project, profile
 		}
 	}
 
+	// Validate the changed devices against the local instances before saving, as a change an
+	// instance refuses would otherwise stay recorded without being applied.
+	for _, inst := range insts {
+		if inst.Node != "" && inst.Node != s.ServerName {
+			continue
+		}
+
+		newProfiles := make([]api.Profile, 0, len(inst.Profiles))
+		for _, profile := range inst.Profiles {
+			if profile.Name == profileName && profile.Project == p.Name {
+				profile.Config = req.Config
+				profile.Devices = req.Devices
+			}
+
+			newProfiles = append(newProfiles, profile)
+		}
+
+		oldDevices := db.ExpandInstanceDevices(inst.Devices, inst.Profiles)
+		newDevices := db.ExpandInstanceDevices(inst.Devices, newProfiles)
+
+		var loaded instance.Instance
+		for name, conf := range newDevices {
+			if maps.Equal(oldDevices[name], conf) {
+				continue
+			}
+
+			if loaded == nil {
+				loaded, err = instance.LoadByProjectAndName(s, inst.Project, inst.Name)
+				if err != nil {
+					return err
+				}
+			}
+
+			_, err = device.New(loaded, s, name, conf, false, func() map[string]string { return map[string]string{} }, func(map[string]string) error { return nil })
+			if err != nil {
+				return fmt.Errorf("Invalid device %q for instance %q: %w", name, inst.Name, err)
+			}
+		}
+	}
+
 	// Update the database.
 	err = s.DB.Cluster.Transaction(ctx, func(ctx context.Context, tx *db.ClusterTx) error {
 		// Re-check in the transaction doing the write, as the profile may have been renamed since.
