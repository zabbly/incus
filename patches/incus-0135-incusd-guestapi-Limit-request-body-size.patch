From ca7e917f820c47a27c1ecccd3ccc9b7f8413161a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:58:42 -0500
Subject: [PATCH] incusd/guestapi: Limit request body size
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The guest API decoded request bodies with no size limit, so a guest
could make the daemon buffer gigabytes outside its own memory limit.

This addresses GHSA-23fc-ggg4-5r2r (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 238d135ee71c5515ee4560ffc76f1f8fe879229b)
---
 cmd/incusd/dev_incus.go | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/cmd/incusd/dev_incus.go b/cmd/incusd/dev_incus.go
index 78ea4de8eb..365960d8a6 100644
--- a/cmd/incusd/dev_incus.go
+++ b/cmd/incusd/dev_incus.go
@@ -324,7 +324,8 @@ func devIncusAPI(d *Daemon, f hoistFunc) http.Handler {
 		router.HandleFunc(handler.path, f(handler.f, d))
 	}
 
-	return router
+	// Limit request body size like the main API.
+	return http.MaxBytesHandler(router, 1024*1024)
 }
 
