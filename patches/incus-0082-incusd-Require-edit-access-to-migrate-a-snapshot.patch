 cmd/incusd/instance_snapshot.go        |  7 +++++++
 cmd/incusd/storage_volumes.go          | 26 ++++++++++++++++++++++++++
 cmd/incusd/storage_volumes_snapshot.go |  7 +++++++
 4 files changed, 41 insertions(+), 25 deletions(-)

