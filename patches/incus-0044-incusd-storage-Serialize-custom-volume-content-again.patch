From 341f0466386d1657eba22bd5dfbb41bfa639265a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Sat, 24 Oct 2026 00:24:47 -0400
Subject: [PATCH] incusd/storage: Serialize custom volume content against
 access
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A custom volume's database record was created before its content was
unpacked, and the SFTP, file, mount and rename paths only needed the
record, so a client could open the volume mid-import and plant a symlink
that redirected the remaining tar members onto host files, written as
root.

Hold a per-volume operation lock while the content is put in place, and
wait on it before serving, mounting, renaming or deleting the volume.

This addresses GHSA-42x8-664j-84w8 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 1b9609b436b6cc850967a70725af3f2d15a99abb)
---
 internal/server/storage/backend.go        | 80 +++++++++++++++++++++++
 internal/server/storage/drivers/volume.go | 15 +++++
 2 files changed, 95 insertions(+)

diff --git a/internal/server/storage/backend.go b/internal/server/storage/backend.go
index b9b79753e5..15ff1714de 100644
--- a/internal/server/storage/backend.go
+++ b/internal/server/storage/backend.go
@@ -5534,12 +5534,28 @@ func (b *backend) bucketServerCert() (*x509.Certificate, error) {
 	return b.state.Endpoints.NetworkCert().PublicKeyX509()
 }
 
+// lockCustomVolume takes the operation lock held while a custom volume's content is put in place,
+// so that access to the volume waits until it is ready.
+func (b *backend) lockCustomVolume(projectName string, volName string) (locking.UnlockFunc, error) {
+	volStorageName := project.StorageVolume(projectName, volName)
+	vol := b.GetVolume(drivers.VolumeTypeCustom, drivers.ContentTypeFS, volStorageName, nil)
+	return locking.Lock(context.TODO(), vol.OperationLockName())
+}
+
 // CreateCustomVolume creates an empty custom volume.
 func (b *backend) CreateCustomVolume(projectName string, volName string, desc string, config map[string]string, contentType drivers.ContentType, op *operations.Operation) error {
 	l := b.logger.AddContext(logger.Ctx{"project": projectName, "volName": volName, "desc": desc, "config": config, "contentType": contentType})
 	l.Debug("CreateCustomVolume started")
 	defer l.Debug("CreateCustomVolume finished")
 
+	// Hold the operation lock while the volume's content is put in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(projectName, volName)
+	if volOpErr != nil {
+		return volOpErr
+	}
+
+	defer volOpUnlock()
+
 	err := b.isStatusReady()
 	if err != nil {
 		return err
@@ -6033,6 +6049,14 @@ func (b *backend) CreateCustomVolumeFromMigration(projectName string, conn io.Re
 		return errors.New("Storage pool does not support custom volume type")
 	}
 
+	// Hold the operation lock while the volume's content is put in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(projectName, args.Name)
+	if volOpErr != nil {
+		return volOpErr
+	}
+
+	defer volOpUnlock()
+
 	var volumeConfig map[string]string
 
 	// Check if the volume exists in database.
@@ -6188,6 +6212,14 @@ func (b *backend) RenameCustomVolume(projectName string, volName string, newVolN
 	l.Debug("RenameCustomVolume started")
 	defer l.Debug("RenameCustomVolume finished")
 
+	// Wait for any in-progress operation still putting this volume's content in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(projectName, volName)
+	if volOpErr != nil {
+		return volOpErr
+	}
+
+	volOpUnlock()
+
 	if internalInstance.IsSnapshot(volName) {
 		return errors.New("Volume name cannot be a snapshot")
 	}
@@ -6590,6 +6622,14 @@ func (b *backend) DeleteCustomVolume(projectName string, volName string, op *ope
 	l.Debug("DeleteCustomVolume started")
 	defer l.Debug("DeleteCustomVolume finished")
 
+	// Wait for any in-progress operation still putting this volume's content in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(projectName, volName)
+	if volOpErr != nil {
+		return volOpErr
+	}
+
+	volOpUnlock()
+
 	_, _, isSnap := api.GetParentAndSnapshotName(volName)
 	if isSnap {
 		return errors.New("Volume name cannot be a snapshot")
@@ -6686,6 +6726,14 @@ func (b *backend) RebuildCustomVolume(projectName string, volName string, op *op
 	l.Debug("RebuildCustomVolume started")
 	defer l.Debug("RebuildCustomVolume finished")
 
+	// Hold the operation lock while the volume's content is put in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(projectName, volName)
+	if volOpErr != nil {
+		return volOpErr
+	}
+
+	defer volOpUnlock()
+
 	err := b.isStatusReady()
 	if err != nil {
 		return err
@@ -6841,6 +6889,14 @@ func (b *backend) MountCustomVolume(projectName, volName string, op *operations.
 	l.Debug("MountCustomVolume started")
 	defer l.Debug("MountCustomVolume finished")
 
+	// Wait for any in-progress operation still putting this volume's content in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(projectName, volName)
+	if volOpErr != nil {
+		return nil, volOpErr
+	}
+
+	volOpUnlock()
+
 	err := b.isStatusReady()
 	if err != nil {
 		return nil, err
@@ -7274,6 +7330,14 @@ func (b *backend) RestoreCustomVolume(projectName, volName string, snapshotName
 	l.Debug("RestoreCustomVolume started")
 	defer l.Debug("RestoreCustomVolume finished")
 
+	// Hold the operation lock while the volume's content is put in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(projectName, volName)
+	if volOpErr != nil {
+		return volOpErr
+	}
+
+	defer volOpUnlock()
+
 	// Quick checks.
 	if internalInstance.IsSnapshot(volName) {
 		return errors.New("Volume cannot be snapshot")
@@ -8375,6 +8439,14 @@ func (b *backend) CreateCustomVolumeFromISO(projectName string, volName string,
 	l.Debug("CreateCustomVolumeFromISO started")
 	defer l.Debug("CreateCustomVolumeFromISO finished")
 
+	// Hold the operation lock while the volume's content is put in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(projectName, volName)
+	if volOpErr != nil {
+		return volOpErr
+	}
+
+	defer volOpUnlock()
+
 	// Check whether we are allowed to create volumes.
 	req := api.StorageVolumesPost{
 		Name: volName,
@@ -8460,6 +8532,14 @@ func (b *backend) CreateCustomVolumeFromBackup(srcBackup backup.Info, srcData io
 	l.Debug("CreateCustomVolumeFromBackup started")
 	defer l.Debug("CreateCustomVolumeFromBackup finished")
 
+	// Hold the operation lock while the volume's content is put in place.
+	volOpUnlock, volOpErr := b.lockCustomVolume(srcBackup.Project, srcBackup.Name)
+	if volOpErr != nil {
+		return volOpErr
+	}
+
+	defer volOpUnlock()
+
 	if srcBackup.Config == nil || srcBackup.Config.Volume == nil {
 		return errors.New("Valid volume config not found in index")
 	}
diff --git a/internal/server/storage/drivers/volume.go b/internal/server/storage/drivers/volume.go
index 134372a2fe..e6bfe56d29 100644
--- a/internal/server/storage/drivers/volume.go
+++ b/internal/server/storage/drivers/volume.go
@@ -749,6 +749,13 @@ func (v Volume) Clone() Volume {
 	return NewVolume(v.driver, v.pool, v.volType, v.contentType, v.name, newConfig, newPoolConfig)
 }
 
+// OperationLockName returns the name of the lock held while a volume's content is being put in
+// place, so that access to the volume waits until it is ready. It omits the content type so the
+// filesystem and ISO/block forms of one custom volume share it.
+func (v Volume) OperationLockName() string {
+	return fmt.Sprintf("volume-operation_%s_%s_%s", v.Pool(), v.Type(), v.Name())
+}
+
 // forkfileLockName returns the forkfile lock name.
 func (v Volume) forkfileLockName() string {
 	return fmt.Sprintf("forkfile_%s_%s_%s", v.Pool(), v.Type(), v.Name())
@@ -794,6 +801,14 @@ func (v Volume) StopForkfile() {
 
 // FileSFTPConn returns a connection to the forkfile handler.
 func (v Volume) FileSFTPConn(s *state.State) (net.Conn, error) {
+	// Wait for any in-progress operation that is still putting this volume's content in place.
+	opUnlock, err := locking.Lock(context.TODO(), v.OperationLockName())
+	if err != nil {
+		return nil, err
+	}
+
+	opUnlock()
+
 	// Lock to avoid concurrent spawning.
 	spawnUnlock, err := locking.Lock(context.TODO(), v.forkfileLockName())
 	if err != nil {
