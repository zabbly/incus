From 4bc6a7efa6c4da0ac8517d744b7c5e77f9ea752a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:05:23 -0500
Subject: [PATCH] incusd/instance/qemu: Bound the TCP agent probe
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The probe sent to guests without vsock had no deadline beyond the hour
long header timeout and never closed its response, so a guest could stall
instance listings and leak a connection per query.

This addresses GHSA-23fc-ggg4-5r2r (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit d089a930f632e4233be6202eebc48d14cae55c03)
---
 internal/server/instance/drivers/driver_qemu.go | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/internal/server/instance/drivers/driver_qemu.go b/internal/server/instance/drivers/driver_qemu.go
index f250bc083b..3a4c52dadc 100644
--- a/internal/server/instance/drivers/driver_qemu.go
+++ b/internal/server/instance/drivers/driver_qemu.go
@@ -469,8 +469,19 @@ func (d *qemu) getAgentClient() (*http.Client, error) {
 					TLSHandshakeTimeout:   time.Second * 3,
 				}
 
-				_, err := client.Get("https://agent/")
+				// The guest answers the probe, don't let it hold the caller or the connection.
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				req, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://agent/", nil)
+				if err != nil {
+					cancel()
+					return nil, err
+				}
+
+				resp, err := client.Do(req)
+				cancel()
 				if err == nil {
+					_ = resp.Body.Close()
+
 					return client, nil
 				}
 			}
