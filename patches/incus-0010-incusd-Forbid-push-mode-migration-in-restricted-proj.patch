From 4a5b2442bd59b242695437a0c2c2fd7dab229291 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Tue, 3 Nov 2026 09:35:02 -0500
Subject: [PATCH] incusd: Forbid push mode migration in restricted projects
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Push mode migration makes the server connect to a user supplied
operation URL just like pull mode does, but it wasn't covered by the
restricted project check on instances, snapshots and custom volumes.

This addresses GHSA-chhj-pwx6-9cx3 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 14b850768fd086b35524588d1e3ac2a472acb991)
---
 cmd/incusd/instance_post.go            |  9 +++++++++
 cmd/incusd/instance_snapshot.go        |  9 +++++++++
 cmd/incusd/storage_volumes.go          |  9 +++++++++
 internal/server/project/permissions.go | 15 +++++++++++++++
 4 files changed, 42 insertions(+)

diff --git a/cmd/incusd/instance_post.go b/cmd/incusd/instance_post.go
index aa2c8dc5e1..188295b65a 100644
--- a/cmd/incusd/instance_post.go
+++ b/cmd/incusd/instance_post.go
@@ -555,6 +555,15 @@ func instancePost(d *Daemon, r *http.Request) response.Response {
 	}
 
 	// Cross-server instance migration.
+	if req.Target != nil {
+		err = s.DB.Cluster.Transaction(r.Context(), func(ctx context.Context, tx *db.ClusterTx) error {
+			return project.AllowMigrationTarget(tx, projectName)
+		})
+		if err != nil {
