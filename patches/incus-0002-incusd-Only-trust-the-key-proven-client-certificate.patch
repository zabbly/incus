From 78e1ccb04763d9f8b614c5b1cee78c88fd91e35c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Tue, 13 Oct 2026 18:42:36 -0400
Subject: [PATCH] incusd: Only trust the key-proven client certificate
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The HTTPS listener uses tls.RequestClientCert, so the TLS handshake only
proves possession of the first certificate in the client's chain. The
authentication and certificate ownership checks looped over the whole
chain and matched each certificate against the trust store, letting a
client authenticate as, or take over, any trust entry by appending that
entry's public certificate to its own chain.

Match only the first peer certificate in every trust-store check.

This addresses GHSA-xg75-xf37-cph9 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
---
 cmd/incus-agent/server.go                | 10 +++---
 cmd/incusd/api_vsock.go                  |  4 +--
 cmd/incusd/certificates.go               | 18 +++-------
 cmd/incusd/daemon.go                     | 31 +++++++++--------
 internal/server/auth/driver_scriptlet.go | 43 ++++++++++++++----------
 internal/server/cluster/tls.go           | 35 ++++++++++---------
 6 files changed, 73 insertions(+), 68 deletions(-)

diff --git a/cmd/incus-agent/server.go b/cmd/incus-agent/server.go
index 87cbc7d9c5..2f9eac286f 100644
--- a/cmd/incus-agent/server.go
+++ b/cmd/incus-agent/server.go
@@ -109,12 +109,10 @@ func createCmd(restAPI *http.ServeMux, version string, c APIEndpoint, cert *x509
 func authenticate(r *http.Request, cert *x509.Certificate) bool {
 	clientCerts := map[string]x509.Certificate{"0": *cert}
 
-	for _, cert := range r.TLS.PeerCertificates {
-		trusted, _ := localUtil.CheckTrustState(*cert, clientCerts, nil, false)
-		if trusted {
-			return true
-		}
+	if len(r.TLS.PeerCertificates) == 0 {
+		return false
 	}
 
-	return false
+	trusted, _ := localUtil.CheckTrustState(*r.TLS.PeerCertificates[0], clientCerts, nil, false)
+	return trusted
 }
diff --git a/cmd/incusd/api_vsock.go b/cmd/incusd/api_vsock.go
index 3e0948522e..e685a6b9fb 100644
--- a/cmd/incusd/api_vsock.go
+++ b/cmd/incusd/api_vsock.go
@@ -45,8 +45,8 @@ func authenticateAgentCert(s *state.State, r *http.Request) (bool, instance.Inst
 
 	agentCert := inst.(instance.VM).AgentCertificate()
 
-	for _, cert := range r.TLS.PeerCertificates {
-		trusted, _ = localUtil.CheckTrustState(*cert, map[string]x509.Certificate{"0": *agentCert}, nil, false)
+	if len(r.TLS.PeerCertificates) > 0 {
+		trusted, _ = localUtil.CheckTrustState(*r.TLS.PeerCertificates[0], map[string]x509.Certificate{"0": *agentCert}, nil, false)
 		if trusted {
 			return true, inst, nil
 		}
