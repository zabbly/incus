From d555949f844cdef74f3869d1716e93ed2cdc1a82 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:11:34 -0500
Subject: [PATCH] incusd/network/acl: Resolve the ACL project per NIC rather
 than per instance
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A NIC on a network shared from the default project uses that project's
ACLs, but usage was keyed on the instance's own network project, so
such NICs were never counted and the ACL rules they relied on could be
deleted or changed underneath them.

Bridged NICs now also look up their ACLs in the network's project, as
OVN NICs already did.

This addresses GHSA-fg2p-r659-c4q8 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit aa5cf57d91a9c4d7e1a4b80bd2fe88d255439d76)
---
 internal/server/device/nic_bridged.go         |  4 +--
 internal/server/network/acl/acl_load.go       | 29 +++++++++----------
 .../network/address-set/address_set_load.go   | 29 +++++++++----------
 3 files changed, 28 insertions(+), 34 deletions(-)

diff --git a/internal/server/device/nic_bridged.go b/internal/server/device/nic_bridged.go
index 91e962e3b7..7a4e6f666f 100644
--- a/internal/server/device/nic_bridged.go
+++ b/internal/server/device/nic_bridged.go
@@ -614,7 +614,7 @@ func (d *nicBridged) validateConfig(instConf instance.ConfigReader, partialValid
 		}
 
 		// The NIC's network may be a non-default project, so lookup project and get network's project name.
-		networkProjectName, _, err := project.NetworkProject(d.state.DB.Cluster, instConf.Project().Name)
+		networkProjectName, _, err := project.NetworkProjectForName(d.state.DB.Cluster, instConf.Project().Name, d.config["network"])
 		if err != nil {
 			return fmt.Errorf("Failed loading network project name: %w", err)
 		}
@@ -1674,7 +1674,7 @@ func (d *nicBridged) setFilters(m deviceConfig.Device) (err error) {
 	if config["security.acls"] != "" {
 		aclNames = util.SplitNTrimSpace(config["security.acls"], ",", -1, false)
 
-		networkProjectName, _, err := project.NetworkProject(d.state.DB.Cluster, d.inst.Project().Name)
+		networkProjectName, _, err := project.NetworkProjectForName(d.state.DB.Cluster, d.inst.Project().Name, config["network"])
 		if err != nil {
 			return err
 		}
