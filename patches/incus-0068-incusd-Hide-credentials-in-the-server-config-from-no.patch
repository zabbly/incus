 	//
@@ -1171,7 +1171,7 @@ var ConfigSchema = config.Schema{
 	//  scope: global
 	//  defaultdesc: Content of `/etc/ovn/key_host` if present
 	//  shortdesc: OVN SSL client key (PEM private key)
