From aaf5c71b74564e60d3277b64f104d7b3de04ca73 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Tue, 17 Nov 2026 15:25:47 -0500
Subject: [PATCH] incus/file: Track symlinks created during a recursive pull by
 identity
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two names can refer to the same file on the local file system, for
example when it's case-insensitive.

This addresses GHSA-whqq-3g5w-5p5w (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
---
 cmd/incus/utils_sftp.go | 32 +++++++++++++++++++++++++++-----
 1 file changed, 27 insertions(+), 5 deletions(-)

diff --git a/cmd/incus/utils_sftp.go b/cmd/incus/utils_sftp.go
index 389d6eb443..70a446ba32 100644
--- a/cmd/incus/utils_sftp.go
+++ b/cmd/incus/utils_sftp.go
@@ -191,14 +191,31 @@ func sftpCreateFile(sftpConn *sftp.Client, targetPath string, args incus.Instanc
 // sftpRecursivePullFile pulls a remote path into targetDir.
 func sftpRecursivePullFile(sftpConn *sftp.Client, fInfo os.FileInfo, source string, normalizedSource string, targetDir string, quiet bool, archive bool, dereference bool, createRoot bool) error {
 	// Symlinks created during this transfer, which a malicious server must not be able to make us follow.
-	symlinks := map[string]struct{}{}
+	symlinks := map[string]os.FileInfo{}
 
 	return sftpRecursivePullEntry(sftpConn, fInfo, source, normalizedSource, targetDir, quiet, archive, dereference, createRoot, symlinks)
 }
 
+// sftpPlantedSymlink returns the symlink created during this transfer that the target refers to.
+// Symlinks are compared by identity as distinct names can refer to the same file on the local file system.
+func sftpPlantedSymlink(target string, symlinks map[string]os.FileInfo) (string, bool) {
+	info, err := os.Lstat(target)
+	if err != nil || info.Mode()&os.ModeSymlink == 0 {
+		return "", false
+	}
+
+	for name, planted := range symlinks {
+		if os.SameFile(info, planted) {
+			return name, true
+		}
+	}
+
+	return "", false
+}
+
 // sftpRecursivePullEntry pulls a remote path and, for directories, its content.
 // Pre-existing symlinks in the target are followed like cp does, but never ones created by this transfer.
-func sftpRecursivePullEntry(sftpConn *sftp.Client, fInfo os.FileInfo, source string, normalizedSource string, targetDir string, quiet bool, archive bool, dereference bool, createRoot bool, symlinks map[string]struct{}) error {
+func sftpRecursivePullEntry(sftpConn *sftp.Client, fInfo os.FileInfo, source string, normalizedSource string, targetDir string, quiet bool, archive bool, dereference bool, createRoot bool, symlinks map[string]os.FileInfo) error {
 	var fileType string
 	if fInfo.IsDir() {
 		fileType = "directory"
@@ -222,14 +239,14 @@ func sftpRecursivePullEntry(sftpConn *sftp.Client, fInfo os.FileInfo, source str
 	logger.Infof("Pulling %s from %s (%s)", target, normalizedSource, fileType)
 
 	// Never write through a symlink planted earlier in this same pull, replace it instead.
-	_, planted := symlinks[target]
+	name, planted := sftpPlantedSymlink(target, symlinks)
 	if planted {
 		err := os.Remove(target)
 		if err != nil {
 			return err
 		}
 
-		delete(symlinks, target)
+		delete(symlinks, name)
 	}
 
 	switch fileType {
@@ -355,7 +372,12 @@ func sftpRecursivePullEntry(sftpConn *sftp.Client, fInfo os.FileInfo, source str
 			return err
 		}
 
-		symlinks[target] = struct{}{}
+		linkInfo, err := os.Lstat(target)
+		if err != nil {
+			return err
+		}
+
+		symlinks[target] = linkInfo
 
 		if archive {
 			sftpSetLocalAttrs(target, fInfo)
