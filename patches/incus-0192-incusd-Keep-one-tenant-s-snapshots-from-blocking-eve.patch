From ca061675785ea989258e1a244abf6decee282164 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:13:43 -0500
Subject: [PATCH] incusd: Keep one tenant's snapshots from blocking everyone
 else's
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The scheduled snapshot tasks stopped at the first instance or volume
that failed, matched schedules by searching for the next tick inside the
database transaction, and accepted a snapshots.pattern that can't be
rendered. One tenant could thereby stall or skip other projects'
snapshots. Schedules are now matched in constant time and capped at 64
entries, patterns are validated, and a failure is logged and skipped.

This addresses GHSA-v855-hxm9-5pwg (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit ee19e37754b69ad77e738fab6ccdf7d4eda3c890)
---
 cmd/incusd/instance.go                 | 10 ++++++----
 cmd/incusd/snapshot_common.go          | 11 +++--------
 cmd/incusd/storage_volumes_snapshot.go | 24 ++++++++++++++++++------
 internal/instance/config.go            | 14 +++++++++++++-
 internal/server/storage/utils.go       |  2 +-
 shared/validate/validate.go            |  8 ++++++--
 6 files changed, 47 insertions(+), 22 deletions(-)

diff --git a/cmd/incusd/instance.go b/cmd/incusd/instance.go
index 949173973e..a30b0c9cba 100644
--- a/cmd/incusd/instance.go
+++ b/cmd/incusd/instance.go
@@ -654,22 +654,23 @@ func autoCreateInstanceSnapshots(ctx context.Context, s *state.State, instances
 
 		l := logger.AddContext(logger.Ctx{"project": inst.Project().Name, "instance": inst.Name()})
 
+		// One instance's failure must not cost the others their snapshot.
 		snapshotName, err := instance.NextSnapshotName(s, inst, "snap%d")
 		if err != nil {
 			l.Error("Error retrieving next snapshot name", logger.Ctx{"err": err})
-			return err
+			continue
 		}
 
 		expiry, err := internalInstance.GetExpiry(time.Now(), inst.ExpandedConfig()["snapshots.expiry"])
 		if err != nil {
 			l.Error("Error getting snapshots.expiry date")
-			return err
+			continue
 		}
 
 		err = inst.Snapshot(snapshotName, expiry, false)
 		if err != nil {
 			l.Error("Error creating snapshot", logger.Ctx{"snapshot": snapshotName, "err": err})
-			return err
+			continue
 		}
 	}
 
@@ -694,7 +695,8 @@ func pruneExpiredInstanceSnapshots(ctx context.Context, snapshots []instance.Ins
 		err = snapshot.Delete(true, true)
 		instSnapshotsPruneRunning.Delete(snapshot.ID())
 		if err != nil {
-			return fmt.Errorf("Failed to delete expired instance snapshot %q in project %q: %w", snapshot.Name(), snapshot.Project().Name, err)
+			logger.Error("Failed to delete expired instance snapshot", logger.Ctx{"project": snapshot.Project().Name, "snapshot": snapshot.Name(), "err": err})
+			continue
 		}
 
 		logger.Debug("Deleted instance snapshot", logger.Ctx{"project": snapshot.Project().Name, "snapshot": snapshot.Name()})
diff --git a/cmd/incusd/snapshot_common.go b/cmd/incusd/snapshot_common.go
index b686929314..9868103fc5 100644
--- a/cmd/incusd/snapshot_common.go
+++ b/cmd/incusd/snapshot_common.go
@@ -107,16 +107,11 @@ func cronSpecIsNow(spec string) (bool, error) {
 	// the time comparison below.
 	now = now.Truncate(time.Minute)
 
-	// Calculate the next scheduled time based on the snapshots.schedule
-	// pattern and the time now.
-	next, err := gronx.NextTickAfter(spec, now, false)
+	// Check whether the schedule matches the coming minute, searching for the next tick is far costlier.
+	due, err := gronx.New().IsDue(spec, now.Add(time.Minute))
 	if err != nil {
 		return false, fmt.Errorf("Could not parse cron '%s': %w", spec, err)
 	}
 
-	if !now.Add(time.Minute).Equal(next) {
-		return false, nil
-	}
-
-	return true, nil
+	return due, nil
 }
diff --git a/cmd/incusd/storage_volumes_snapshot.go b/cmd/incusd/storage_volumes_snapshot.go
