From 769063beb7369a443faafcfdcb935fbf67c57ca9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Tue, 3 Nov 2026 09:35:02 -0500
Subject: [PATCH] incusd/storage/s3: Bound aws-chunked chunk sizes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The aws-chunked decoder allocated the declared chunk size up front,
with no bound and no check against the declared decoded length, so a
bucket key holder could make the daemon reserve gigabytes per request.

This addresses GHSA-537m-jhcr-hxmm (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 2471be37cc8046b0ce281f154241b57290564e69)
---
 internal/server/storage/s3/local/auth.go    |  2 +-
 internal/server/storage/s3/local/chunked.go | 28 ++++++++++++++++++---
 2 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/internal/server/storage/s3/local/auth.go b/internal/server/storage/s3/local/auth.go
index 086bf62063..4a65c81d3d 100644
--- a/internal/server/storage/s3/local/auth.go
+++ b/internal/server/storage/s3/local/auth.go
@@ -419,7 +419,7 @@ func wrapStreamingBody(r *http.Request, bodyHash string, parsed *parsedAuthoriza
 
 	body := r.Body
 	r.Body = &readerCloser{
-		Reader: newChunkedReader(body, sign),
+		Reader: newChunkedReader(body, sign, r.ContentLength),
 		Closer: body,
 	}
 
diff --git a/internal/server/storage/s3/local/chunked.go b/internal/server/storage/s3/local/chunked.go
index 421cd57a7f..41704a8247 100644
--- a/internal/server/storage/s3/local/chunked.go
+++ b/internal/server/storage/s3/local/chunked.go
@@ -14,6 +14,9 @@ import (
 // the chunk and trailer string-to-sign as the canonical-headers slot.
 var emptyStringSHA256 = sha256Hex(nil)
 
+// maxChunkSize bounds a single chunk, which has to be buffered to verify its signature.
+const maxChunkSize = 16 * 1024 * 1024
+
 // chunkSigningContext carries the data needed to verify per-chunk SigV4
 // signatures for STREAMING-AWS4-HMAC-SHA256-PAYLOAD[-TRAILER] payloads.
 type chunkSigningContext struct {
@@ -55,14 +58,19 @@ type chunkedReader struct {
 	// finished is set once the terminating zero-length chunk (and trailer,
 	// if any) has been fully consumed.
 	finished bool
+
+	// remaining is the declared decoded length still to be read, or -1 when unknown.
+	remaining int64
 }
 
 // newChunkedReader wraps r in an aws-chunked decoder. If sign is non-nil,
-// per-chunk signatures are verified.
-func newChunkedReader(r io.Reader, sign *chunkSigningContext) *chunkedReader {
+// per-chunk signatures are verified. A non-negative decodedLength caps the
+// total payload at the declared decoded content length.
+func newChunkedReader(r io.Reader, sign *chunkSigningContext, decodedLength int64) *chunkedReader {
 	return &chunkedReader{
-		br:   bufio.NewReader(r),
-		sign: sign,
+		br:        bufio.NewReader(r),
+		sign:      sign,
+		remaining: decodedLength,
 	}
 }
 
@@ -108,7 +116,19 @@ func (c *chunkedReader) nextChunk() error {
 		return fmt.Errorf("invalid chunk size %q", sizeField)
 	}
 
+	if size > maxChunkSize {
+		return fmt.Errorf("chunk size %d exceeds the maximum of %d", size, maxChunkSize)
+	}
+
+	if c.remaining >= 0 && size > c.remaining {
+		return errors.New("chunk size exceeds the declared decoded content length")
+	}
+
 	if size > 0 {
+		if c.remaining >= 0 {
+			c.remaining -= size
+		}
+
 		if cap(c.chunk) < int(size) {
 			c.chunk = make([]byte, size)
 		} else {
