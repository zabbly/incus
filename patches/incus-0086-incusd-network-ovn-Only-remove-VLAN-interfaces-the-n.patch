From 4ffaff273c0b63871fb5d056bcafd9710b58dc3e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:30:10 -0500
Subject: [PATCH] incusd/network/ovn: Only remove VLAN interfaces the network
 created
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A refused network create could leave a pending record behind when the
client dropped the connection, and deleting that record removed any
host interface named in bridge.external_interfaces. The revert now
runs on its own context, pending networks skip the interface cleanup,
and only a matching VLAN interface is ever removed.

This addresses GHSA-fg2p-r659-c4q8 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 2ee1c53d7acad0faeabf871b2afe0736421f18d2)
---
 cmd/incusd/networks.go                |  3 ++-
 internal/server/network/driver_ovn.go | 30 +++++++++++++++++++++------
 2 files changed, 26 insertions(+), 7 deletions(-)

diff --git a/cmd/incusd/networks.go b/cmd/incusd/networks.go
index bd0f261999..5b8c1f9ab0 100644
--- a/cmd/incusd/networks.go
+++ b/cmd/incusd/networks.go
@@ -673,7 +673,8 @@ func networksPost(d *Daemon, r *http.Request) response.Response {
 	}
 
 	reverter.Add(func() {
-		_ = s.DB.Cluster.Transaction(r.Context(), func(ctx context.Context, tx *db.ClusterTx) error {
+		// The request context may be gone by the time the revert runs.
+		_ = s.DB.Cluster.Transaction(context.Background(), func(ctx context.Context, tx *db.ClusterTx) error {
 			return tx.DeleteNetwork(ctx, projectName, req.Name)
 		})
 	})
diff --git a/internal/server/network/driver_ovn.go b/internal/server/network/driver_ovn.go
index 48cd670a20..2da874fa03 100644
--- a/internal/server/network/driver_ovn.go
+++ b/internal/server/network/driver_ovn.go
@@ -4417,11 +4417,28 @@ func (n *ovn) deleteExternalInterfaces() error {
 			return fmt.Errorf("Failed detaching external interface %q: %w", entry, err)
 		}
 
-		if len(entryParts) == 3 {
-			err = InterfaceRemove(entry)
-			if err != nil {
-				return fmt.Errorf("Failed removing external interface %q: %w", entry, err)
-			}
+		if len(entryParts) != 3 {
+			continue
+		}
+
+		// Only remove the VLAN interface the extended syntax describes, never a pre-existing one.
+		vlanID, err := strconv.Atoi(strings.TrimSpace(entryParts[2]))
+		if err != nil {
+			continue
+		}
+
+		linkInfo, err := ip.LinkByName(entry)
+		if err != nil {
+			return fmt.Errorf("Failed to get link info for external interface %q", entry)
+		}
+
+		if linkInfo.Kind != "vlan" || linkInfo.Parent != strings.TrimSpace(entryParts[1]) || linkInfo.VlanID != vlanID {
+			continue
+		}
+
+		err = InterfaceRemove(entry)
+		if err != nil {
+			return fmt.Errorf("Failed removing external interface %q: %w", entry, err)
 		}
 	}
 
@@ -4451,7 +4468,8 @@ func (n *ovn) Delete(clientType request.ClientType) error {
 	}
 
 	// Detach the external interfaces, removing those created from the extended syntax.
-	if n.config["bridge.external_interfaces"] != "" {
+	// A locally pending network never attached anything, so leave the host alone.
+	if n.config["bridge.external_interfaces"] != "" && n.LocalStatus() != api.NetworkStatusPending {
 		err = n.deleteExternalInterfaces()
 		if err != nil {
 			n.logger.Warn("Failed cleaning up external interfaces during delete, continuing with deletion", logger.Ctx{"err": err})
