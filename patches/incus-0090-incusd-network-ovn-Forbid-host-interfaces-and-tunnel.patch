From f02585366f294023624a536ae3f8a66717a86277 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:34:47 -0500
Subject: [PATCH] incusd/network/ovn: Forbid host interfaces and tunnels in
 restricted projects
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Both options attach host interfaces or encapsulated host traffic to the
network's switch and were only checked for syntax.

This addresses GHSA-fg2p-r659-c4q8 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 44d8aa53c5d84ee3dcae56925f43daea07d46856)
---
 internal/server/network/driver_ovn.go | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/internal/server/network/driver_ovn.go b/internal/server/network/driver_ovn.go
index 2da874fa03..9e824eedba 100644
--- a/internal/server/network/driver_ovn.go
+++ b/internal/server/network/driver_ovn.go
@@ -986,6 +986,15 @@ func (n *ovn) Validate(config map[string]string, clientType request.ClientType)
 		return fmt.Errorf("Failed to load network restrictions from project %q: %w", n.project, err)
 	}
 
+	// Host interfaces and tunnels attach host traffic to the network, which a restricted project can't be trusted with.
+	if util.IsTrue(p.Config["restricted"]) {
+		for k := range config {
+			if k == "bridge.external_interfaces" || strings.HasPrefix(k, "tunnel.") {
+				return fmt.Errorf("Option %q isn't allowed in a restricted project", k)
+			}
+		}
+	}
+
 	// Check uplink network is valid and allowed in project.
 	var uplink *api.Network
 	projectRestrictedSubnets := []*net.IPNet{}
