From 8a367931388016f0d2f70d7a1126561694951ad1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Tue, 3 Nov 2026 09:35:02 -0500
Subject: [PATCH] incusd/operations: Strip the state secret from renders too
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Live migration adds a state connection whose secret was missing from
the strip list, so it was still broadcast on the event stream and
returned by operation queries.

This addresses GHSA-j5qp-xv8h-whfp (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 6b0cf84979eaae2c475f7ab2b12aea2169d15096)
---
 client/operations.go                     | 2 +-
 internal/server/operations/operations.go | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/client/operations.go b/client/operations.go
index 0ced5a9cd0..60234d5068 100644
--- a/client/operations.go
+++ b/client/operations.go
@@ -103,7 +103,7 @@ func (op *operation) Get() api.Operation {
 // websocket secrets. The server returns them only in the synchronous create
 // response and strips them from later renders (events and queries), so keep
 // this in sync with the server's strip list.
-var connectSecretKeys = []string{api.SecretNameControl, api.SecretNameFilesystem, "fds"}
+var connectSecretKeys = []string{api.SecretNameControl, api.SecretNameFilesystem, api.SecretNameState, "fds"}
 
 // applyUpdate replaces the tracked operation, preserving the per-connection
 // websocket secrets delivered in the create response but absent from later renders.
diff --git a/internal/server/operations/operations.go b/internal/server/operations/operations.go
index b382990671..ef3a34eabb 100644
--- a/internal/server/operations/operations.go
+++ b/internal/server/operations/operations.go
@@ -504,7 +504,7 @@ func (op *Operation) mayCancel() bool {
 // secrets. They're returned to the operation's creator in the synchronous create
 // response but stripped from every other render, so they're never broadcast on the
 // event stream or exposed through operation queries.
-var connectSecretKeys = []string{api.SecretNameControl, api.SecretNameFilesystem, "fds"}
+var connectSecretKeys = []string{api.SecretNameControl, api.SecretNameFilesystem, api.SecretNameState, "fds"}
 
 // Render renders the operation for events and API queries, with any websocket
 // connection secrets removed.
