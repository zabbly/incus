From cd6421772c4a165918f26db191fe6f23ca5ab157 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:27:56 -0500
Subject: [PATCH] incusd: Require edit access on the target of a refresh
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Refreshing into an existing instance or custom volume was only checked
against the project's create entitlement.

This addresses GHSA-8553-6xmq-7g3g (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 4d9863f55533dc3540c568a5524206a9dcf5303c)
---
 cmd/incusd/instances_post.go  | 26 ++++++++++++++++++++++++++
 cmd/incusd/storage_volumes.go | 21 +++++++++++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/cmd/incusd/instances_post.go b/cmd/incusd/instances_post.go
index c977536030..827fd14d35 100644
--- a/cmd/incusd/instances_post.go
+++ b/cmd/incusd/instances_post.go
@@ -1400,6 +1400,32 @@ func instancesPost(d *Daemon, r *http.Request) response.Response {
 		}
 	}
 
+	// A refresh overwrites an existing instance, which requires edit access to it.
+	if req.Source.Refresh && req.Name != "" {
+		var exists bool
+
+		err = s.DB.Cluster.Transaction(r.Context(), func(ctx context.Context, tx *db.ClusterTx) error {
+			id, err := tx.GetInstanceID(ctx, targetProjectName, req.Name)
+			if err != nil && !response.IsNotFoundError(err) {
+				return err
+			}
+
+			exists = err == nil && id > 0
+
+			return nil
+		})
+		if err != nil {
+			return response.SmartError(err)
+		}
+
+		if exists {
+			err = s.Authorizer.CheckPermission(r.Context(), r, auth.ObjectInstance(targetProjectName, req.Name), auth.EntitlementCanEdit)
+			if err != nil {
+				return response.SmartError(err)
+			}
+		}
+	}
+
 	err = s.DB.Cluster.Transaction(r.Context(), func(ctx context.Context, tx *db.ClusterTx) error {
 		dbProject, err := dbCluster.GetProject(ctx, tx.Tx(), targetProjectName)
 		if err != nil {
diff --git a/cmd/incusd/storage_volumes.go b/cmd/incusd/storage_volumes.go
index 11f9da5bf2..f2a21f9a39 100644
--- a/cmd/incusd/storage_volumes.go
+++ b/cmd/incusd/storage_volumes.go
@@ -951,6 +951,27 @@ func storagePoolVolumesPost(d *Daemon, r *http.Request) response.Response {
 		return response.Conflict(errors.New("Volume by that name already exists"))
 	}
 
+	// A refresh overwrites the existing volume, which requires edit access to it.
+	if dbVolume != nil {
+		var location string
+
+		if s.ServerClustered {
+			pool, err := storagePools.LoadByName(s, poolName)
+			if err != nil {
+				return response.SmartError(err)
+			}
+
+			if !pool.Driver().Info().Remote {
+				location = dbVolume.Location
+			}
+		}
+
+		err = s.Authorizer.CheckPermission(r.Context(), r, auth.ObjectStorageVolume(projectName, poolName, db.StoragePoolVolumeTypeNameCustom, req.Name, location), auth.EntitlementCanEdit)
+		if err != nil {
+			return response.SmartError(err)
+		}
+	}
+
 	// Check if we need to switch to migration
 	serverName := s.ServerName
 	var nodeAddress string
