From ce3698200b02c8c30b2bd6cc9ece597f9a14a408 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Fri, 23 Oct 2026 22:54:24 -0400
Subject: [PATCH] incusd: Stop restricted clients rewriting their certificate
 projects
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

certificatePatch decoded the body over a shallow copy of the stored
entry, so the JSON decoder overwrote the shared project slice before the
"only the certificate can be changed" check compared it with itself. A
restricted client could move its certificate into any project.

Clone the project slice before decoding, and return on the TLS guard.

This addresses GHSA-9m5m-cr24-m367 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit bcfd20fbbc342a2b078f96d9356aeb298c2fa0ec)
---
 cmd/incusd/certificates.go | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/cmd/incusd/certificates.go b/cmd/incusd/certificates.go
index 9220fbf85a..0db908db96 100644
--- a/cmd/incusd/certificates.go
+++ b/cmd/incusd/certificates.go
@@ -11,6 +11,7 @@ import (
 	"fmt"
 	"net"
 	"net/http"
+	"slices"
 	"time"
 
 	incus "github.com/lxc/incus/v7/client"
@@ -1049,8 +1050,9 @@ func certificatePatch(d *Daemon, r *http.Request) response.Response {
 		return response.PreconditionFailed(err)
 	}
 
-	// Apply the changes.
+	// Apply the changes (on a copy, as the JSON decoder reuses existing slices).
 	req := *apiEntry
+	req.Projects = slices.Clone(apiEntry.Projects)
 	err = json.NewDecoder(r.Body).Decode(&req)
 	if err != nil {
 		return response.BadRequest(err)
@@ -1269,7 +1271,7 @@ func certificateDelete(d *Daemon, r *http.Request) response.Response {
 		// Non-admins are able to delete only their own certificate.
 		if !userCanEditCertificate {
 			if r.TLS == nil {
-				response.Forbidden(errors.New("Cannot delete certificate"))
+				return response.Forbidden(errors.New("Cannot delete certificate"))
 			}
 
 			certBlock, _ := pem.Decode([]byte(certInfo.Certificate))
