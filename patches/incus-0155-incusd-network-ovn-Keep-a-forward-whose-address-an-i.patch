From 566a26451d58d7b581e1913d35b79d0c2358d88c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:04:52 -0500
Subject: [PATCH] incusd/network/ovn: Keep a forward whose address an instance
 NIC still uses
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This addresses GHSA-fg2p-r659-c4q8 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 3d47fcf71d48754bce9c4d1003f4d0f75946c205)
---
 internal/server/network/driver_ovn.go | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/internal/server/network/driver_ovn.go b/internal/server/network/driver_ovn.go
index 9e824eedba..e494a8ea55 100644
--- a/internal/server/network/driver_ovn.go
+++ b/internal/server/network/driver_ovn.go
@@ -7629,6 +7629,22 @@ func (n *ovn) ForwardDelete(listenAddress string, clientType request.ClientType)
 			return err
 		}
 
+		// Refuse to release a listen address still used as the external address of an instance NIC.
+		listenIP := net.ParseIP(forward.ListenAddress)
+		err = UsedByInstanceDevices(n.state, n.Project(), n.Name(), n.Type(), func(inst db.InstanceArgs, nicName string, nicConfig map[string]string) error {
+			for _, keyPrefix := range []string{"ipv4", "ipv6"} {
+				extIP := net.ParseIP(nicConfig[fmt.Sprintf("%s.address.external", keyPrefix)])
+				if extIP != nil && extIP.Equal(listenIP) {
+					return api.StatusErrorf(http.StatusBadRequest, "Network forward is in use as the external address of an instance NIC")
+				}
+			}
+
+			return nil
+		})
+		if err != nil {
+			return err
+		}
+
 		// Delete the network forward itself.
 		err = n.ovnnb.DeleteLoadBalancer(context.TODO(), n.getLoadBalancerName(forward.ListenAddress))
 		if err != nil {
