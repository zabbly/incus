From 343077fbe0f12f2c71b2ac1ccc7844c11019417a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:07:08 -0500
Subject: [PATCH] incusd: Name automatic volume snapshots from the volume's own
 snapshots
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This addresses GHSA-8m9x-vx2q-7f9q (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 7789d9015c8dfc8279a85e92f253ec755476fc2a)
---
 cmd/incusd/storage_volumes_snapshot.go   | 44 ++++--------------------
 internal/server/db/storage_pools_test.go |  4 +--
 internal/server/db/storage_volumes.go    |  6 ++--
 3 files changed, 13 insertions(+), 41 deletions(-)

diff --git a/cmd/incusd/storage_volumes_snapshot.go b/cmd/incusd/storage_volumes_snapshot.go
index 6b5169b2dc..ff830563f9 100644
--- a/cmd/incusd/storage_volumes_snapshot.go
+++ b/cmd/incusd/storage_volumes_snapshot.go
@@ -240,7 +240,7 @@ func storagePoolVolumeSnapshotsTypePost(d *Daemon, r *http.Request) response.Res
 		var i int
 
 		_ = s.DB.Cluster.Transaction(r.Context(), func(ctx context.Context, tx *db.ClusterTx) error {
-			i = tx.GetNextStorageVolumeSnapshotIndex(ctx, poolName, volumeName, volumeType, renderedPattern)
+			i = tx.GetNextStorageVolumeSnapshotIndex(ctx, projectName, poolName, volumeName, volumeType, renderedPattern)
 
 			return nil
 		})
@@ -1737,7 +1737,7 @@ func volumeDetermineNextSnapshotName(ctx context.Context, s *state.State, volume
 		var i int
 
 		_ = s.DB.Cluster.Transaction(ctx, func(ctx context.Context, tx *db.ClusterTx) error {
-			i = tx.GetNextStorageVolumeSnapshotIndex(ctx, volume.PoolName, volume.Name, db.StoragePoolVolumeTypeCustom, pattern)
+			i = tx.GetNextStorageVolumeSnapshotIndex(ctx, volume.ProjectName, volume.PoolName, volume.Name, db.StoragePoolVolumeTypeCustom, pattern)
 
 			return nil
 		})
@@ -1747,52 +1747,22 @@ func volumeDetermineNextSnapshotName(ctx context.Context, s *state.State, volume
 
 	snapshotExists := false
 
+	// Only the volume's own snapshots matter, same-named volumes elsewhere are unrelated.
 	var snapshots []db.StorageVolumeArgs
-	var projects []string
-	var pools []string
-
 	err = s.DB.Cluster.Transaction(ctx, func(ctx context.Context, tx *db.ClusterTx) error {
-		projects, err = dbCluster.GetProjectNames(ctx, tx.Tx())
+		poolID, err := tx.GetStoragePoolID(ctx, volume.PoolName)
 		if err != nil {
 			return err
 		}
 
-		pools, err = tx.GetStoragePoolNames(ctx)
-		if err != nil {
-			return err
-		}
+		snapshots, err = tx.GetLocalStoragePoolVolumeSnapshotsWithType(ctx, volume.ProjectName, volume.Name, db.StoragePoolVolumeTypeCustom, poolID)
 
-		return nil
+		return err
 	})
 	if err != nil {
 		return "", err
 	}
 
-	for _, pool := range pools {
-		var poolID int64
-
-		err = s.DB.Cluster.Transaction(ctx, func(ctx context.Context, tx *db.ClusterTx) error {
-			poolID, err = tx.GetStoragePoolID(ctx, pool)
-			if err != nil {
-				return err
-			}
-
-			for _, project := range projects {
-				snaps, err := tx.GetLocalStoragePoolVolumeSnapshotsWithType(ctx, project, volume.Name, db.StoragePoolVolumeTypeCustom, poolID)
-				if err != nil {
-					return err
-				}
-
-				snapshots = append(snapshots, snaps...)
-			}
-
-			return nil
-		})
-		if err != nil {
-			return "", err
-		}
-	}
-
 	for _, snap := range snapshots {
 		_, snapOnlyName, _ := api.GetParentAndSnapshotName(snap.Name)
 
@@ -1806,7 +1776,7 @@ func volumeDetermineNextSnapshotName(ctx context.Context, s *state.State, volume
 		var i int
 
 		_ = s.DB.Cluster.Transaction(ctx, func(ctx context.Context, tx *db.ClusterTx) error {
-			i = tx.GetNextStorageVolumeSnapshotIndex(ctx, volume.PoolName, volume.Name, db.StoragePoolVolumeTypeCustom, pattern)
+			i = tx.GetNextStorageVolumeSnapshotIndex(ctx, volume.ProjectName, volume.PoolName, volume.Name, db.StoragePoolVolumeTypeCustom, pattern)
 
 			return nil
 		})
diff --git a/internal/server/db/storage_pools_test.go b/internal/server/db/storage_pools_test.go
index 6628a2e899..bab44e612f 100644
--- a/internal/server/db/storage_pools_test.go
+++ b/internal/server/db/storage_pools_test.go
@@ -276,10 +276,10 @@ func TestCreateStoragePoolVolume_Snapshot(t *testing.T) {
 		_, err = tx.CreateStorageVolumeSnapshot(ctx, "default", "v1/snap0", "", 1, poolID, config, time.Now(), time.Time{})
 		require.NoError(t, err)
 
-		n := tx.GetNextStorageVolumeSnapshotIndex(ctx, "p1", "v1", 1, "snap%d")
+		n := tx.GetNextStorageVolumeSnapshotIndex(ctx, "default", "p1", "v1", 1, "snap%d")
 		assert.Equal(t, n, 1)
 
-		n = tx.GetNextStorageVolumeSnapshotIndex(ctx, "p2", "v1", 1, "snap%d")
+		n = tx.GetNextStorageVolumeSnapshotIndex(ctx, "default", "p2", "v1", 1, "snap%d")
 		assert.Equal(t, n, 0)
 
 		return nil
diff --git a/internal/server/db/storage_volumes.go b/internal/server/db/storage_volumes.go
index b431475fac..7cda9ab262 100644
--- a/internal/server/db/storage_volumes.go
+++ b/internal/server/db/storage_volumes.go
@@ -702,20 +702,22 @@ func (c *ClusterTx) storageVolumeConfigGet(ctx context.Context, volumeID int64,
 //
 // Note, the code below doesn't deal with snapshots of snapshots.
 // To do that, we'll need to weed out based on # slashes in names.
-func (c *ClusterTx) GetNextStorageVolumeSnapshotIndex(ctx context.Context, pool, name string, typ int, pattern string) int {
+func (c *ClusterTx) GetNextStorageVolumeSnapshotIndex(ctx context.Context, projectName string, pool, name string, typ int, pattern string) int {
 	remoteDrivers := StorageRemoteDriverNames()
 
 	q := fmt.Sprintf(`
 SELECT storage_volumes_snapshots.name FROM storage_volumes_snapshots
   JOIN storage_volumes ON storage_volumes_snapshots.storage_volume_id=storage_volumes.id
   JOIN storage_pools ON storage_volumes.storage_pool_id=storage_pools.id
+  JOIN projects ON storage_volumes.project_id=projects.id
  WHERE storage_volumes.type=?
    AND storage_volumes.name=?
    AND storage_pools.name=?
+   AND projects.name=?
    AND (storage_volumes.node_id=? OR storage_volumes.node_id IS NULL AND storage_pools.driver IN %s)
 `, query.Params(len(remoteDrivers)))
 	var numstr string
-	inargs := []any{typ, name, pool, c.nodeID}
+	inargs := []any{typ, name, pool, projectName, c.nodeID}
 	outfmt := []any{numstr}
 
 	for _, driver := range remoteDrivers {
