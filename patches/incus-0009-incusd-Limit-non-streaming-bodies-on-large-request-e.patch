From e79c4afdcff1b71e58e8e0ed70c46cc8256c8215 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Tue, 3 Nov 2026 09:35:02 -0500
Subject: [PATCH] incusd: Limit non-streaming bodies on large request endpoints
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The symlink upload and JSON create branches of the endpoints exempted
from the request body limit buffered the whole body, so a restricted
client could make the daemon allocate memory proportional to an
arbitrarily large request.

This addresses GHSA-cxqx-x785-5926 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit e71e3b1cbd64082e75b353ea5bc96658966f7659)
---
 cmd/incusd/instance_file.go   | 8 ++++++--
 cmd/incusd/instances_post.go  | 4 ++--
 cmd/incusd/storage_buckets.go | 4 ++--
 cmd/incusd/storage_volumes.go | 4 ++--
 4 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/cmd/incusd/instance_file.go b/cmd/incusd/instance_file.go
index a18f115184..1c49e90d0c 100644
--- a/cmd/incusd/instance_file.go
+++ b/cmd/incusd/instance_file.go
@@ -586,12 +586,16 @@ func fileSFTPPost(client *sftp.Client, path string, r *http.Request, onSuccess f
 		onSuccess()
 		return response.EmptySyncResponse
 	case "symlink":
-		// Figure out target.
-		target, err := io.ReadAll(r.Body)
+		// Figure out target, bounded to the maximum symlink length.
+		target, err := io.ReadAll(io.LimitReader(r.Body, 4097))
 		if err != nil {
 			return response.InternalError(err)
 		}
 
+		if len(target) > 4096 {
+			return response.BadRequest(errors.New("Symlink target is too long"))
+		}
+
 		// Check if already setup.
 		currentTarget, err := client.ReadLink(path)
 		if err == nil && currentTarget == string(target) {
diff --git a/cmd/incusd/instances_post.go b/cmd/incusd/instances_post.go
index de0a24b598..d777256626 100644
--- a/cmd/incusd/instances_post.go
+++ b/cmd/incusd/instances_post.go
@@ -1272,9 +1272,9 @@ func instancesPost(d *Daemon, r *http.Request) response.Response {
 		return createFromBackup(s, r, targetProjectName, r.Body, r.Header.Get("X-Incus-pool"), r.Header.Get("X-Incus-name"), r.Header.Get("X-Incus-config"), r.Header.Get("X-Incus-devices"))
 	}
 
-	// Parse the request
+	// Parse the request, applying the usual size limit to the JSON body.
 	req := api.InstancesPost{}
-	err := json.NewDecoder(r.Body).Decode(&req)
+	err := json.NewDecoder(http.MaxBytesReader(nil, r.Body, 1024*1024)).Decode(&req)
 	if err != nil {
 		return response.BadRequest(err)
 	}
diff --git a/cmd/incusd/storage_buckets.go b/cmd/incusd/storage_buckets.go
index d60dd8d880..ddef0d9905 100644
--- a/cmd/incusd/storage_buckets.go
+++ b/cmd/incusd/storage_buckets.go
@@ -747,9 +747,9 @@ func storagePoolBucketsPost(d *Daemon, r *http.Request) response.Response {
 		return createStoragePoolBucketFromBackup(s, r, request.ProjectParam(r), bucketProjectName, r.Body, poolName, r.Header.Get("X-Incus-name"))
 	}
 
-	// Parse the request into a record.
+	// Parse the request into a record, applying the usual size limit to the JSON body.
 	req := api.StorageBucketsPost{}
-	err = json.NewDecoder(r.Body).Decode(&req)
+	err = json.NewDecoder(http.MaxBytesReader(nil, r.Body, 1024*1024)).Decode(&req)
 	if err != nil {
 		return response.BadRequest(err)
 	}
diff --git a/cmd/incusd/storage_volumes.go b/cmd/incusd/storage_volumes.go
index c8cb451c71..70d85d8df8 100644
--- a/cmd/incusd/storage_volumes.go
+++ b/cmd/incusd/storage_volumes.go
@@ -881,8 +881,8 @@ func storagePoolVolumesPost(d *Daemon, r *http.Request) response.Response {
 
 	req := api.StorageVolumesPost{}
 
-	// Parse the request.
-	err = json.NewDecoder(r.Body).Decode(&req)
+	// Parse the request, applying the usual size limit to the JSON body.
+	err = json.NewDecoder(http.MaxBytesReader(nil, r.Body, 1024*1024)).Decode(&req)
 	if err != nil {
 		return response.BadRequest(err)
 	}
