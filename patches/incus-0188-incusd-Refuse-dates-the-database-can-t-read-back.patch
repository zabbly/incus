diff --git a/internal/instance/expiry.go b/internal/instance/expiry.go
index f4ec06d0b8..f08d0f8e69 100644
--- a/internal/instance/expiry.go
+++ b/internal/instance/expiry.go
@@ -65,5 +65,10 @@ func GetExpiry(refDate time.Time, s string) (time.Time, error) {
 		time.Hour*time.Duration(expiry["H"]) + time.Minute*time.Duration(expiry["M"]) + time.Second*time.Duration(expiry["S"]),
 	)
 
+	// The database can't store dates past year 9999.
+	if t.Year() > 9999 {
+		return time.Time{}, ErrInvalidExpiry
+	}
+
 	return t, nil
 }
diff --git a/internal/server/db/time.go b/internal/server/db/time.go
new file mode 100644
index 0000000000..24c11cb182
--- /dev/null
+++ b/internal/server/db/time.go
@@ -0,0 +1,20 @@
+package db
+
+import (
+	"errors"
+	"time"
+)
+
+// CheckTime returns an error when a time can't be stored in the database and read back.
+func CheckTime(t time.Time) error {
+	if t.IsZero() {
+		return nil
+	}
+
+	year := t.UTC().Year()
+	if year < 1 || year > 9999 {
+		return errors.New("Dates must fall between years 1 and 9999")
+	}
+
+	return nil
+}
