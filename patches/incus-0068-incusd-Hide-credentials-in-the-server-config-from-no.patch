From 8eecc450695b2707b4b28b60147f09c2b5aa0bda Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:33:39 -0500
Subject: [PATCH] incusd: Hide credentials in the server config from
 non-editors
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Viewers with can_view_sensitive were shown every configured value,
including the OpenFGA API token and other secrets.

This addresses GHSA-44g3-g988-46rg (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit b852059392c93f685f726abc1d0c1800e0813b2f)
---
 cmd/incusd/api_1.0.go                    | 10 ++++++++++
 cmd/incusd/daemon_config.go              | 14 ++++++++++++++
 internal/server/cluster/config/config.go | 18 +++++++++---------
 internal/server/config/schema.go         |  1 +
 4 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/cmd/incusd/api_1.0.go b/cmd/incusd/api_1.0.go
index 842c98ff46..d644927c2c 100644
--- a/cmd/incusd/api_1.0.go
+++ b/cmd/incusd/api_1.0.go
@@ -428,6 +428,16 @@ func api10Get(d *Daemon, r *http.Request) response.Response {
 		return response.SyncResponseETag(true, fullSrv, nil)
 	}
 
+	// Only those allowed to change the config get to see the credentials in it.
+	err = s.Authorizer.CheckPermission(r.Context(), r, auth.ObjectServer(), auth.EntitlementCanEdit)
+	if err != nil {
+		if !api.StatusErrorCheck(err, http.StatusForbidden) {
+			return response.SmartError(err)
+		}
+
+		daemonConfigHideSecrets(fullSrvConfig)
+	}
+
 	fullSrv.Config = fullSrvConfig
 
 	etag, err := daemonConfigETag(s, r)
diff --git a/cmd/incusd/daemon_config.go b/cmd/incusd/daemon_config.go
index 7cb04a88ae..87005bfeb6 100644
--- a/cmd/incusd/daemon_config.go
+++ b/cmd/incusd/daemon_config.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"maps"
 	"net/http"
+	"strings"
 
 	clusterConfig "github.com/lxc/incus/v7/internal/server/cluster/config"
 	"github.com/lxc/incus/v7/internal/server/db"
@@ -37,6 +38,19 @@ func daemonConfigRender(s *state.State) (map[string]string, error) {
 	return config, nil
 }
 
+// daemonConfigHideSecrets removes the credentials from a rendered config.
+func daemonConfigHideSecrets(config map[string]string) {
+	for key := range config {
+		if clusterConfig.ConfigSchema[key].Hidden || node.ConfigSchema[key].Hidden {
+			delete(config, key)
+		}
+
+		if strings.HasPrefix(key, "logging.") && strings.HasSuffix(key, ".target.password") {
+			delete(config, key)
+		}
+	}
+}
+
 // daemonConfigETag returns the config used for ETag checks, excluding node-local keys on untargeted cluster requests.
 func daemonConfigETag(s *state.State, r *http.Request) (map[string]string, error) {
 	if s.ServerClustered && request.QueryParam(r, "target") == "" {
