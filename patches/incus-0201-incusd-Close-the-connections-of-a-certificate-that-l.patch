 // GetCertificatesAndProjects returns certificate and project maps.
 func (c *Cache) GetCertificatesAndProjects() (map[Type]map[string]x509.Certificate, map[string][]string) {
 	c.mu.RLock()
diff --git a/internal/server/events/events.go b/internal/server/events/events.go
index e1bc76a704..61b040d225 100644
--- a/internal/server/events/events.go
+++ b/internal/server/events/events.go
@@ -66,6 +66,22 @@ func (s *Server) SetLocalLocation(location string) {
 	s.location = location
 }
 
+// CloseListeners closes the listeners opened by a matching identity.
+func (s *Server) CloseListeners(match func(protocol string, username string) bool) {
+	s.lock.Lock()
+	defer s.lock.Unlock()
+
+	for _, listener := range s.listeners {
+		listener.lock.Lock()
+		matched := listener.username != "" && match(listener.protocol, listener.username)
+		listener.lock.Unlock()
+
+		if matched {
+			listener.Close()
+		}
+	}
+}
+
 // AddListener creates and returns a new event listener.
 func (s *Server) AddListener(projectName string, allProjects bool, serverEvents bool, projectPermissionFunc auth.PermissionChecker, connection EventListenerConnection, messageTypes []string, excludeSources []EventSource, recvFunc EventHandler, excludeLocations []string) (*Listener, error) {
 	if allProjects && projectName != "" {
@@ -243,4 +259,15 @@ type Listener struct {
 	projectPermissionFunc auth.PermissionChecker
 	excludeSources        []EventSource
 	excludeLocations      []string
+	protocol              string
+	username              string
+}
+
+// SetRequestor records the identity the listener was opened with.
+func (l *Listener) SetRequestor(protocol string, username string) {
+	l.lock.Lock()
+	defer l.lock.Unlock()
+
+	l.protocol = protocol
+	l.username = username
 }
diff --git a/internal/server/response/response.go b/internal/server/response/response.go
index cbd6ef481e..749ff16a41 100644
--- a/internal/server/response/response.go
+++ b/internal/server/response/response.go
@@ -654,6 +654,23 @@ type upgradeResponse struct {
 	cleanup  func()
 }
 
+var (
+	upgradedConnsMu sync.Mutex
+	upgradedConns   = map[*upgradeResponse]net.Conn{}
+)
+
+// CloseUpgradedConnections closes the hijacked connections whose request matches.
+func CloseUpgradedConnections(match func(r *http.Request) bool) {
+	upgradedConnsMu.Lock()
+	defer upgradedConnsMu.Unlock()
+
+	for resp, conn := range upgradedConns {
+		if match(resp.req) {
+			_ = conn.Close()
+		}
+	}
+}
+
 // String returns the response type name.
 func (r *upgradeResponse) String() string {
 	return r.protocol + " handler"
@@ -684,6 +701,17 @@ func (r *upgradeResponse) Render(w http.ResponseWriter) error {
 
 	defer logger.WarnOnErrorExcept(remoteConn.Close, []error{net.ErrClosed}, "Failed to close remote connection")
 
+	// Keep track of it so a lost trust can end it.
+	upgradedConnsMu.Lock()
+	upgradedConns[r] = remoteConn
+	upgradedConnsMu.Unlock()
+
+	defer func() {
+		upgradedConnsMu.Lock()
+		delete(upgradedConns, r)
+		upgradedConnsMu.Unlock()
+	}()
+
 	remoteTCP, _ := tcp.ExtractConn(remoteConn)
 	if remoteTCP != nil {
 		// Apply TCP timeouts if remote connection is TCP (rather than Unix).
