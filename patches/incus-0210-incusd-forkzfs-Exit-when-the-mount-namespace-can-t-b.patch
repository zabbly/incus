From 014bc6cfcb5cbd65a5348eb992fdca332f484f5b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:08:11 -0500
Subject: [PATCH] incusd/forkzfs: Exit when the mount namespace can't be
 unshared
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A failed unshare left the helper in the daemon's mount namespace,
where it then detached every mount under the daemon's directory.

This addresses GHSA-28m6-7v43-rr8m (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 53a46f9e72c371711d75a11618aa3c0593eea018)
---
 cmd/incusd/main_nsexec.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cmd/incusd/main_nsexec.go b/cmd/incusd/main_nsexec.go
index 0bc4d22ed3..3c7fdc730d 100644
--- a/cmd/incusd/main_nsexec.go
+++ b/cmd/incusd/main_nsexec.go
@@ -355,7 +355,7 @@ __attribute__((constructor)) void init(void) {
 		ret = unshare(CLONE_NEWNS);
 		if (ret < 0) {
 			fprintf(stderr, "Failed unshare of mount namespace: %s\n", strerror(errno));
-			return;
+			_exit(1);
 		}
 	}
 }
