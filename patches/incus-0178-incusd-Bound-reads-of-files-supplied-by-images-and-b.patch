From 06605ec4cac567f7836fadf2e504e031b31df8be Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:13:10 -0500
Subject: [PATCH] incusd: Bound reads of files supplied by images and backups
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

metadata.yaml, templates, the OCI config, the NVRAM file and the DHCP
DUID all come from the instance volume and were read whole, so a sparse
file in an image or backup could exhaust the daemon's memory.

This addresses GHSA-42x8-664j-84w8 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit cbae2399eb82cf5d78a23869c0ff4efc1cb76a15)
---
 cmd/incusd/instance_metadata.go               | 13 +++++++++++--
 cmd/incusd/main_forknet.go                    | 14 +++++++++++++-
 .../server/instance/drivers/driver_common.go  |  6 +++++-
 .../server/instance/drivers/driver_lxc.go     |  2 +-
 .../server/instance/drivers/driver_qemu.go    | 10 ++++++++--
 internal/server/instance/instance_utils.go    |  3 +++
 internal/server/instance/oci.go               | 19 ++++++++++++++++++-
 7 files changed, 59 insertions(+), 8 deletions(-)

diff --git a/cmd/incusd/instance_metadata.go b/cmd/incusd/instance_metadata.go
index f7644a671b..1a5acd7a8c 100644
--- a/cmd/incusd/instance_metadata.go
+++ b/cmd/incusd/instance_metadata.go
@@ -139,7 +139,7 @@ func instanceMetadataGet(d *Daemon, r *http.Request) response.Response {
 
 	defer logger.WarnOnError(metadataFile.Close, "Failed to close metadata file")
 
-	data, err := io.ReadAll(metadataFile)
+	data, err := io.ReadAll(io.LimitReader(metadataFile, instance.FileMaxSize))
 	if err != nil {
 		return response.InternalError(err)
 	}
@@ -259,7 +259,7 @@ func instanceMetadataPatch(d *Daemon, r *http.Request) response.Response {
 	if err == nil {
 		defer logger.WarnOnError(metadataFile.Close, "Failed to close metadata file")
 
-		data, err := io.ReadAll(metadataFile)
+		data, err := io.ReadAll(io.LimitReader(metadataFile, instance.FileMaxSize))
 		if err != nil {
 			return response.InternalError(err)
 		}
@@ -560,6 +560,15 @@ func instanceMetadataTemplatesGet(d *Daemon, r *http.Request) response.Response
 
 	defer logger.WarnOnError(template.Close, "Failed to close template file")
 
+	fi, err := template.Stat()
+	if err != nil {
+		return response.SmartError(err)
+	}
+
+	if !fi.Mode().IsRegular() || fi.Size() > instance.FileMaxSize {
+		return response.BadRequest(errors.New("Invalid template file"))
+	}
+
 	tempfile, err := os.CreateTemp("", "incus_template")
 	if err != nil {
 		return response.SmartError(err)
diff --git a/cmd/incusd/main_forknet.go b/cmd/incusd/main_forknet.go
index 452d2d902c..957e37d4bc 100644
--- a/cmd/incusd/main_forknet.go
+++ b/cmd/incusd/main_forknet.go
@@ -969,11 +969,23 @@ func (c *cmdForknet) dhcpRunV6(errorChannel chan error, ready func(), iface stri
 	}
 }
 
+// readFileLimited reads at most limit bytes of a file the instance may have planted.
+func readFileLimited(path string, limit int64) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+
+	defer func() { _ = f.Close() }()
+
+	return io.ReadAll(io.LimitReader(f, limit))
+}
+
 // Get a stable DUID, recording it on disk.
 func (c *cmdForknet) loadOrCreateDUID(ifaces []net.Interface) (dhcpv6.DUID, error) {
 	duidPath := filepath.Join(c.instNetworkPath, "dhcp6.duid")
 
-	bb, err := os.ReadFile(duidPath)
+	bb, err := readFileLimited(duidPath, 4096)
 	if err == nil {
 		duid, err := dhcpv6.DUIDFromBytes(bb)
 		if err == nil {
