From 44a1d37cf242ef987306c48c8cb0bc72c221bd81 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:06:09 -0500
Subject: [PATCH] incusd: Close the connections of a certificate that lost
 trust
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Event streams and hijacked connections such as SFTP were authorized
once at setup and kept going after the certificate was removed from the
trust store or had its projects changed.

This addresses GHSA-9m5m-cr24-m367 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 98e3b844f16b29621d4256cabed1127469522f45)
---
 cmd/incusd/certificates.go           | 48 ++++++++++++++++++++++++++++
 cmd/incusd/events.go                 |  2 ++
 internal/server/certificate/cache.go |  9 ++++++
 internal/server/events/events.go     | 27 ++++++++++++++++
 internal/server/response/response.go | 28 ++++++++++++++++
 5 files changed, 114 insertions(+)

diff --git a/cmd/incusd/certificates.go b/cmd/incusd/certificates.go
index e623de1432..f9e6a88d2b 100644
--- a/cmd/incusd/certificates.go
+++ b/cmd/incusd/certificates.go
@@ -289,7 +289,55 @@ func updateCertificateCache(d *Daemon) {
 		// continue functioning, and hopefully the write will succeed on next update.
 	}
 
+	oldCerts := d.clientCerts.GetAPICertificates()
 	d.clientCerts.SetCertificates(certs)
+
+	// Connections opened with a certificate that lost trust or changed scope end here.
+	changed := []string{}
+	for fingerprint, oldCert := range oldCerts {
+		newCert, ok := d.clientCerts.GetAPICertificates()[fingerprint]
+		if !ok {
+			changed = append(changed, fingerprint)
+			continue
+		}
+
+		// Gaining access doesn't need the connections closed.
+		lostProject := slices.ContainsFunc(oldCert.Projects, func(project string) bool {
+			return !slices.Contains(newCert.Projects, project)
+		})
+
+		if newCert.Restricted && (!oldCert.Restricted || lostProject) {
+			changed = append(changed, fingerprint)
+		}
+	}
+
+	if len(changed) == 0 {
+		return
+	}
+
+	match := func(protocol string, username string) bool {
+		return protocol == api.AuthenticationMethodTLS && slices.Contains(changed, username)
+	}
+
+	s.Events.CloseListeners(match)
+	response.CloseUpgradedConnections(func(r *http.Request) bool {
+		return match(requestIdentity(r))
+	})
+}
+
+// requestIdentity returns the protocol and user name a request was authenticated with.
+func requestIdentity(r *http.Request) (string, string) {
+	protocol, ok := r.Context().Value(request.CtxProtocol).(string)
+	if !ok {
+		return "", ""
+	}
+
+	username, ok := r.Context().Value(request.CtxUsername).(string)
+	if !ok {
+		return protocol, ""
+	}
+
+	return protocol, username
 }
 
 // certificateCacheProjectRemoved reloads the trust cache everywhere after a project name was deleted or renamed.
diff --git a/cmd/incusd/events.go b/cmd/incusd/events.go
index 606f93fd9c..22ffd038a2 100644
--- a/cmd/incusd/events.go
+++ b/cmd/incusd/events.go
@@ -170,6 +170,8 @@ func eventsSocket(s *state.State, r *http.Request, w http.ResponseWriter) error
 		return nil
 	}
 
+	listener.SetRequestor(requestIdentity(r))
+
 	listener.Wait(r.Context())
 
 	return nil
