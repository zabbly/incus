From 89fa6e2991329cbe79edb465bc50c55ce19335e3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Thu, 22 Oct 2026 07:41:58 -0400
Subject: [PATCH] incusd/storage: Reject a symlinked block file when unpacking
 backups and images
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This addresses GHSA-f886-r3x9-fp2r (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 56f506fa21a7b231ccbbbc2061d791732f527c4e)
---
 internal/server/storage/drivers/utils.go | 8 ++++++++
 internal/server/storage/utils.go         | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/internal/server/storage/drivers/utils.go b/internal/server/storage/drivers/utils.go
index 03fbe248df..9ea63441bc 100644
--- a/internal/server/storage/drivers/utils.go
+++ b/internal/server/storage/drivers/utils.go
@@ -1284,6 +1284,14 @@ func UnpackVolume(d Driver, vol Volume, r io.ReadSeeker, tarArgs []string, unpac
 		unpackBlockVolume := func(hdr *tar.Header) error {
 			var allowUnsafeResize bool
 
+			// The filesystem stream may have replaced the block file inside the volume with a symlink.
+			if strings.HasPrefix(targetPath, internalUtil.AddSlash(mountPath)) {
+				fi, err := os.Lstat(targetPath)
+				if err == nil && !fi.Mode().IsRegular() {
+					return fmt.Errorf("Block volume file %q isn't a regular file", targetPath)
+				}
+			}
+
 			// Reset the disk.
 			err = linux.ClearBlock(targetPath, 0)
 			if err != nil {
diff --git a/internal/server/storage/utils.go b/internal/server/storage/utils.go
index fc2c882194..c83cf00b47 100644
--- a/internal/server/storage/utils.go
+++ b/internal/server/storage/utils.go
@@ -665,6 +665,14 @@ func ImageUnpack(imageFile string, vol drivers.Volume, destBlockFile string, sys
 	// convertBlockImage converts the qcow2 block image file into a raw block device. If needed it will attempt
 	// to enlarge the destination volume to accommodate the unpacked qcow2 image file.
 	convertBlockImage := func(v drivers.Volume, imgPath string, dstPath string, tracker *ioprogress.ProgressTracker) (int64, error) {
+		// The metadata stream may have replaced the block file inside the volume with a symlink.
+		if strings.HasPrefix(dstPath, internalUtil.AddSlash(destPath)) {
+			fi, err := os.Lstat(dstPath)
+			if err == nil && !fi.Mode().IsRegular() {
+				return -1, fmt.Errorf("Block volume file %q isn't a regular file", dstPath)
+			}
+		}
+
 		// Get info about qcow2 file. Force input format to qcow2 so we don't rely on qemu-img's detection
 		// logic as that has been known to have vulnerabilities and we only support qcow2 images anyway.
 		// Use prlimit because qemu-img can consume considerable RAM & CPU time if fed a maliciously
