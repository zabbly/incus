From 9fad6f52b23d4c44121e84eb650a7e9a61468de3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Sat, 3 Oct 2026 19:44:23 -0400
Subject: [PATCH] incusd/storage: Validate dependent volumes received through
 migration
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The names of dependent volumes received through migration were used as
path segments without validation, letting a malicious source create
volumes outside of the storage pool.

The index header sent by the source was also indexed by the position of
the volume in the offer header, with no check that the lists match, and
optional protobuf fields were dereferenced unconditionally, letting a
malicious source crash the daemon.

Validate the names as is done for backups, check the index header
before using it and use the nil-safe protobuf getters.

This addresses GHSA-q9fc-p923-6vp7 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
---
 .../server/instance/drivers/driver_lxc.go     |  9 +++++-
 .../server/instance/drivers/driver_qemu.go    |  9 +++++-
 .../server/migration/migration_volumes.go     | 10 +++----
 internal/server/storage/backend.go            | 20 +++++++++++--
 internal/server/storage/utils.go              | 30 ++++++++++++++++---
 5 files changed, 65 insertions(+), 13 deletions(-)

diff --git a/internal/server/instance/drivers/driver_lxc.go b/internal/server/instance/drivers/driver_lxc.go
index 9245e96642..db40bc6281 100644
--- a/internal/server/instance/drivers/driver_lxc.go
+++ b/internal/server/instance/drivers/driver_lxc.go
@@ -6424,6 +6424,13 @@ func (d *lxc) MigrateSend(args instance.MigrateSendArgs) error {
 		return err
 	}
 
+	// The target can only negotiate types for the volumes we offered, not redefine them.
+	err = storagePools.ValidateDependentVolumesAgainstOffer(offerHeader.DependentVolumes, respHeader.DependentVolumes)
+	if err != nil {
+		op.Done(err)
+		return err
+	}
+
 	volumesWithTypes, err := storagePools.DependentVolumesMatchMigrationType(d.state, respHeader.DependentVolumes, args.Snapshots, nil, true, clusterMove)
 	if err != nil {
 		err := fmt.Errorf("Failed to negotiate migration types for dependent volumes: %w", err)
@@ -7024,7 +7031,7 @@ func (d *lxc) MigrateReceive(args instance.MigrateReceiveArgs) error {
 	dependentVolumes := []localMigration.DependentVolumeArgs{}
 	for _, volWithType := range volumesWithTypes {
 		respHeader.DependentVolumes = append(respHeader.DependentVolumes, volWithType.Volume)
-		vol := localMigration.ProtobufToDependentVolume(volWithType.Volume, volWithType.VolumeTypes[0], localDevices[*volWithType.Volume.DeviceName])
+		vol := localMigration.ProtobufToDependentVolume(volWithType.Volume, volWithType.VolumeTypes[0], localDevices[volWithType.Volume.GetDeviceName()])
 		dependentVolumes = append(dependentVolumes, vol)
 	}
 
