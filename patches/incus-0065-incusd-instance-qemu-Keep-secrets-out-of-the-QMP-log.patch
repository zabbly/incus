From 589d5e3d68a07a256830d036136eb18ace6b788a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:32:45 -0500
Subject: [PATCH] incusd/instance/qemu: Keep secrets out of the QMP log
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The log is served to anyone allowed to view the instance.

This addresses GHSA-44g3-g988-46rg (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit eb33bfe7a55df154b489f57ea6d2f6c1d705a455)
---
 internal/server/instance/drivers/qmp/commands.go | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/internal/server/instance/drivers/qmp/commands.go b/internal/server/instance/drivers/qmp/commands.go
index 7172d1e96e..345eb0812a 100644
--- a/internal/server/instance/drivers/qmp/commands.go
+++ b/internal/server/instance/drivers/qmp/commands.go
@@ -1139,7 +1139,14 @@ func (m *Monitor) AddSecret(id string, secret string) error {
 		"format":   "base64",
 	}
 
-	err := m.Run("object-add", &args, nil)
+	// Keep the secret out of the QMP log, which is served to instance viewers.
+	reqID := m.IncreaseID()
+	request, err := json.Marshal(qmpCommand{ID: reqID, Execute: "object-add", Arguments: &args})
+	if err != nil {
+		return err
+	}
+
+	err = m.RunJSON(request, nil, false, reqID)
 	if err != nil && !strings.Contains(err.Error(), "attempt to add duplicate property") {
 		return fmt.Errorf("Failed adding object: %w", err)
 	}
