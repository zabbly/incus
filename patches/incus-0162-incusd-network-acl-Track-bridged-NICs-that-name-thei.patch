+				_, found := aclNets[key]
+				if !found {
+					aclNets[key] = NetworkACLUsage{
+						Name:         nicConfig["parent"],
+						Type:         "bridge",
+						InstanceName: u.Name,
+						DeviceName:   devName,
+					}
+				}
+
+				return nil
+			}
+
 			networkID, network, _, err := tx.GetNetworkInAnyState(ctx, aclProjectName, nicConfig["network"])
 			if err != nil {
 				return fmt.Errorf("Failed to load network %q: %w", nicConfig["network"], err)
