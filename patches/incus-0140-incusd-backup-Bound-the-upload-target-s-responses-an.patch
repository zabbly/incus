From ff0a951803d7e9107c2ca0c9cb5f52b6cc0ad313 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:02:53 -0500
Subject: [PATCH] incusd/backup: Bound the upload target's responses and stalls
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The backup upload target is chosen by the client. Cap every response
read back from it at 1MiB and require progress on the connection
within a minute, so a hostile target can't pin the daemon's memory.

This addresses GHSA-3jgx-fpg2-x499 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 2de1b92166eb5a7215557bed0303ac329256f034)
---
 internal/server/backup/backup_utils.go | 85 +++++++++++++++++++++++---
 1 file changed, 78 insertions(+), 7 deletions(-)

diff --git a/internal/server/backup/backup_utils.go b/internal/server/backup/backup_utils.go
index 60c92b57b9..f82176c8c3 100644
--- a/internal/server/backup/backup_utils.go
+++ b/internal/server/backup/backup_utils.go
@@ -6,6 +6,7 @@ import (
 	"errors"
 	"fmt"
 	"io"
+	"net"
 	"net/http"
 	"net/url"
 	"time"
@@ -17,6 +18,7 @@ import (
 
 	"github.com/lxc/incus/v7/internal/server/storage/s3util"
 	"github.com/lxc/incus/v7/internal/server/sys"
+	localUtil "github.com/lxc/incus/v7/internal/server/util"
