diff --git a/cmd/incus/utils.go b/cmd/incus/utils.go
index 48347a4b82..fbd9f32eba 100644
--- a/cmd/incus/utils.go
+++ b/cmd/incus/utils.go
@@ -14,6 +14,7 @@ import (
 	"path"
 	"path/filepath"
 	"reflect"
+	"runtime"
 	"slices"
 	"sort"
 	"strconv"
@@ -945,3 +946,39 @@ func parseMode(m string, mode fs.FileMode, umask fs.FileMode, isDir bool) (fs.Fi
 func parsePristineMode(m string) (fs.FileMode, error) {
 	return parseMode(m, fs.FileMode(0), fs.FileMode(0), false)
 }
+
+// nbdListen sets up the local NBD listener, defaulting to a private unix socket.
+func nbdListen(conf *config.Config, address string) (net.Listener, error) {
+	if address != "" {
+		return net.Listen("tcp", address)
+	}
+
+	// Same fallback as the console on Windows.
+	if runtime.GOOS == "windows" {
+		return net.Listen("tcp", "127.0.0.1:0")
+	}
+
+	if conf.ConfigDir == "" {
+		return nil, errors.New(i18n.G("No configuration directory available, an address must be specified"))
+	}
+
+	err := os.MkdirAll(conf.ConfigPath("sockets"), 0o700)
+	if err != nil {
+		return nil, err
+	}
+
+	// Generate a random file name.
+	f, err := os.CreateTemp(conf.ConfigPath("sockets"), "*.nbd")
+	if err != nil {
+		return nil, err
+	}
+
+	_ = f.Close()
+
+	err = os.Remove(f.Name())
+	if err != nil {
+		return nil, err
+	}
+
+	return net.Listen("unix", f.Name())
+}
