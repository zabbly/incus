 )
 
 // swagger:operation POST /1.0/instances/{name}/bitmaps instances instance_bitmaps_post
@@ -98,6 +99,11 @@ func instanceBitmapsPost(d *Daemon, r *http.Request) response.Response {
 		return response.BadRequest(err)
 	}
 
