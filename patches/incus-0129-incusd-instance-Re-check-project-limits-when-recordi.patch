From 8c48de7a4e837d94f62fd5fed7b703cd239795c1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 20:05:31 -0500
Subject: [PATCH] incusd/instance: Re-check project limits when recording an
 update
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The limits were checked in one transaction and the config written in
another, so concurrent updates of different instances each passed
against the others' old values.

This addresses GHSA-9pvj-5r2h-r873 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 30cf32db5cf044e77079f9a8fffcd8845d66c21b)
---
 internal/server/instance/drivers/driver_lxc.go  | 8 +++++++-
 internal/server/instance/drivers/driver_qemu.go | 8 +++++++-
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/internal/server/instance/drivers/driver_lxc.go b/internal/server/instance/drivers/driver_lxc.go
index a6d8ffeba6..fc6e4b1305 100644
--- a/internal/server/instance/drivers/driver_lxc.go
+++ b/internal/server/instance/drivers/driver_lxc.go
@@ -5802,7 +5802,13 @@ func (d *lxc) Update(args db.InstanceArgs, userRequested bool) error {
 			profileNames = append(profileNames, profile.Name)
 		}
 
-		return cluster.UpdateInstanceProfiles(ctx, tx.Tx(), object.ID, object.Project, profileNames)
+		err = cluster.UpdateInstanceProfiles(ctx, tx.Tx(), object.ID, object.Project, profileNames)
+		if err != nil {
+			return err
+		}
+
+		// Re-check the project limits with the new config recorded, concurrent updates each passed on the old one.
+		return project.CheckLimits(tx, d.project.Name)
 	})
 	if err != nil {
 		return fmt.Errorf("Failed to update database: %w", err)
diff --git a/internal/server/instance/drivers/driver_qemu.go b/internal/server/instance/drivers/driver_qemu.go
index f3b7e79722..ddfde49a15 100644
--- a/internal/server/instance/drivers/driver_qemu.go
+++ b/internal/server/instance/drivers/driver_qemu.go
@@ -7994,7 +7994,13 @@ func (d *qemu) Update(args db.InstanceArgs, userRequested bool) error {
 			profileNames = append(profileNames, profile.Name)
 		}
 
-		return dbCluster.UpdateInstanceProfiles(ctx, tx.Tx(), object.ID, object.Project, profileNames)
+		err = dbCluster.UpdateInstanceProfiles(ctx, tx.Tx(), object.ID, object.Project, profileNames)
+		if err != nil {
+			return err
+		}
+
+		// Re-check the project limits with the new config recorded, concurrent updates each passed on the old one.
+		return project.CheckLimits(tx, d.project.Name)
 	})
 	if err != nil {
 		return fmt.Errorf("Failed to update database: %w", err)
