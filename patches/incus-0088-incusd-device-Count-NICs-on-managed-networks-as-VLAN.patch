From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Wed, 4 Nov 2026 19:33:02 -0500
Subject: [PATCH] incusd/device: Count NICs on managed networks as VLAN
 interface users
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

NICs attached through a managed network carry no parent or vlan key, so
the VLAN interface they share was removed when its creator stopped.

This addresses GHSA-fg2p-r659-c4q8 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 0b92361ceec1404623d16aeeaebc7b0dfb55fc55)
---
 .../server/device/device_utils_network.go     | 32 +++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/internal/server/device/device_utils_network.go b/internal/server/device/device_utils_network.go
index b4304952ee..b1000b78b8 100644
--- a/internal/server/device/device_utils_network.go
+++ b/internal/server/device/device_utils_network.go
@@ -90,6 +90,32 @@ func NetworkSetDevMAC(devName string, mac string) error {
 	return nil
 }
 
+// networkNICUsesVLANDevice checks whether a NIC uses the given parent and VLAN, resolving managed networks.
+func networkNICUsesVLANDevice(s *state.State, dev deviceConfig.Device, parent string, vlanID string, networks map[string]map[string]string) bool {
+	if dev["type"] != "nic" {
+		return false
+	}
+
+	devParent := dev["parent"]
+	devVLAN := dev["vlan"]
+	if dev["network"] != "" {
+		netConfig, found := networks[dev["network"]]
+		if !found {
+			n, err := network.LoadByName(s, api.ProjectDefaultName, dev["network"])
+			if err == nil {
+				netConfig = n.Config()
+			}
+
+			networks[dev["network"]] = netConfig
+		}
+
+		devParent = netConfig["parent"]
+		devVLAN = netConfig["vlan"]
+	}
+
+	return devParent == parent && devVLAN == vlanID
+}
+
 // networkRemoveInterfaceIfNeeded removes a network interface by name but only if no other instance is using it.
 func networkRemoveInterfaceIfNeeded(s *state.State, nic string, current instance.Instance, parent string, vlanID string) error {
 	// Check if it's used by another instance.
@@ -98,13 +124,14 @@ func networkRemoveInterfaceIfNeeded(s *state.State, nic string, current instance
 		return err
 	}
 
+	networks := map[string]map[string]string{}
 	for _, inst := range instances {
 		if inst.Name() == current.Name() && inst.Project().Name == current.Project().Name {
 			continue
 		}
 
 		for devName, dev := range inst.ExpandedDevices() {
-			if dev["type"] != "nic" || dev["vlan"] != vlanID || dev["parent"] != parent {
+			if !networkNICUsesVLANDevice(s, dev, parent, vlanID, networks) {
 				continue
 			}
 
@@ -136,9 +163,10 @@ func networkCreateVlanDeviceIfNeeded(s *state.State, parent string, vlanDevice s
 			return "", err
 		}
 
+		networks := map[string]map[string]string{}
 		for _, inst := range instances {
 			for devName, dev := range inst.ExpandedDevices() {
-				if dev["type"] != "nic" || dev["vlan"] != vlanID || dev["parent"] != parent {
+				if !networkNICUsesVLANDevice(s, dev, parent, vlanID, networks) {
 					continue
 				}
 
