From 0cc6496f73267d9e6db18082f7b0923e5ce9f961 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Sat, 24 Oct 2026 00:57:38 -0400
Subject: [PATCH] incusd: Serialize instance rewrites on volume rename and
 profile update
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Rewriting the instances affected by a custom volume rename/move or a
profile update wrote back a copy of each instance record listed before
the loop, without the instance lock or a reload, so a concurrent
instance update could be silently reverted, dropping a required key like
security.idmap.isolated. The volume path also ran the write inside the
listing transaction, holding the global database connection for 30s.

Collect the instances first, then update each under its operation lock
from the current record, and refresh the profile-update path the same
way.

This addresses GHSA-mmh3-jfjc-6vc2 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 54f272c9c4fe2e89a79a06f82ec55aa9641130bd)
---
 cmd/incusd/profiles_utils.go        | 18 ++++++
 cmd/incusd/storage_volumes_utils.go | 98 ++++++++++++++++++-----------
 2 files changed, 81 insertions(+), 35 deletions(-)

diff --git a/cmd/incusd/profiles_utils.go b/cmd/incusd/profiles_utils.go
index 26a939a046..6511513297 100644
--- a/cmd/incusd/profiles_utils.go
+++ b/cmd/incusd/profiles_utils.go
@@ -235,6 +235,24 @@ func doProfileUpdateInstance(ctx context.Context, s *state.State, args db.Instan
 		return err
 	}
 
+	// Serialise with instance PUT/PATCH and refresh the config and devices from the current record,
+	// so a concurrent instance update isn't reverted by writing back the copy listed earlier. The
+	// profile content stays as it was before the update, so Update still detects the change.
+	unlock, err := instanceOperationLock(s.ShutdownCtx, args.Project, args.Name)
+	if err != nil {
+		return err
+	}
+
+	defer unlock()
+
+	current, err := instance.LoadByProjectAndName(s, args.Project, args.Name)
+	if err != nil {
+		return err
+	}
+
+	args.Config = current.LocalConfig()
+	args.Devices = current.LocalDevices()
+
 	// Load the instance using the old profile config.
 	inst, err := instance.Load(s, args, p)
 	if err != nil {
