+	if err != nil {
+		return nil, err
+	}
+
 	if imageType != "" && imageType != "unified" && imageType != "split" {
 		return nil, errors.New("Invalid image format")
 	}
@@ -1003,6 +1008,11 @@ func getImgPostInfo(ctx context.Context, s *state.State, r *http.Request, buildd
 		info.CreatedAt = time.Unix(imageMeta.CreationDate, 0)
 	}
 
+	err = db.CheckTime(info.CreatedAt)
+	if err != nil {
+		return nil, fmt.Errorf("Invalid creation date: %w", err)
+	}
+
 	expiresAt, ok := metadata["expires_at"]
 	if ok {
 		expiry, ok := expiresAt.(time.Time)
@@ -1013,6 +1023,11 @@ func getImgPostInfo(ctx context.Context, s *state.State, r *http.Request, buildd
 		info.ExpiresAt = time.Unix(imageMeta.ExpiryDate, 0)
 	}
 
+	err = db.CheckTime(info.ExpiresAt)
+	if err != nil {
+		return nil, fmt.Errorf("Invalid expiry date: %w", err)
+	}
+
 	properties, ok := metadata["properties"]
 	if ok {
 		props, ok := properties.(map[string]string)
@@ -3608,6 +3623,11 @@ func imagePut(d *Daemon, r *http.Request) response.Response {
 
 	// Get ExpiresAt
 	if !req.ExpiresAt.IsZero() {
+		err = db.CheckTime(req.ExpiresAt)
+		if err != nil {
+			return response.BadRequest(err)
+		}
+
 		info.ExpiresAt = req.ExpiresAt
 	}
 
