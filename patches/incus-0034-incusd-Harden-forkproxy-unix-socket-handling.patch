From ae62b22462a8032ecd0f9afe26b518e84a1a5654 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Fri, 23 Oct 2026 23:15:07 -0400
Subject: [PATCH] incusd: Harden forkproxy unix socket handling
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The forkproxy child chowned and chmodded the listen socket by path after
binding, so a local user owning the directory could swap it for a
symlink and have root chown an arbitrary host file. The AppArmor profile
also resolved both socket paths on the host and printed them unquoted,
letting a planted symlink inject policy or block the start.

Bind with the final mode, chown the socket through an O_NOFOLLOW
descriptor, resolve only the host-side path (just the directory for a
host listen socket), quote the rules and reject metacharacters.

This addresses GHSA-p8fx-6xxm-25wh (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
(cherry picked from commit 2c91de2f191c6fada5a295b3163f8dd47a7f3edb)
---
 cmd/incusd/main_forkproxy.go                  | 32 ++++++++---
 .../server/apparmor/instance_forkproxy.go     | 55 +++++++++++++------
 .../apparmor/instance_forkproxy.profile.go    |  2 +-
 3 files changed, 61 insertions(+), 28 deletions(-)

diff --git a/cmd/incusd/main_forkproxy.go b/cmd/incusd/main_forkproxy.go
index 2bca2b26ba..52caed7508 100644
--- a/cmd/incusd/main_forkproxy.go
+++ b/cmd/incusd/main_forkproxy.go
@@ -470,6 +470,16 @@ func (c *cmdForkproxy) run(cmd *cobra.Command, args []string) error {
 			if err != nil && !errors.Is(err, fs.ErrNotExist) {
 				return err
 			}
+
+			// Bind the socket with its final mode, so it's never briefly world-accessible and needs no chmod by path.
+			if args[8] != "" {
+				mode, err := strconv.ParseUint(args[8], 8, 0)
+				if err != nil {
+					return err
+				}
+
+				unix.Umask(int(^mode & 0o777))
+			}
 		}
 
 		var listenAddresses []string
@@ -524,24 +534,28 @@ func (c *cmdForkproxy) run(cmd *cobra.Command, args []string) error {
 			}
 
 			if listenAddrGID != -1 || listenAddrUID != -1 {
-				err = os.Chown(lAddr.Address, listenAddrUID, listenAddrGID)
+				// Chown the socket itself, never a path a local user may have swapped for a symlink.
+				fd, err := unix.Open(lAddr.Address, unix.O_PATH|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
 				if err != nil {
 					return err
 				}
-			}
 
-			var listenAddrMode os.FileMode
-			if args[8] != "" {
-				tmp, err := strconv.ParseUint(args[8], 8, 0)
+				var st unix.Stat_t
+				err = unix.Fstat(fd, &st)
 				if err != nil {
+					_ = unix.Close(fd)
 					return err
 				}
 
-				listenAddrMode = os.FileMode(tmp)
-				err = os.Chmod(lAddr.Address, listenAddrMode)
-				if err != nil {
-					return err
+				if st.Mode&unix.S_IFMT == unix.S_IFSOCK {
+					err = unix.Fchownat(fd, "", listenAddrUID, listenAddrGID, unix.AT_EMPTY_PATH)
+					if err != nil {
+						_ = unix.Close(fd)
+						return err
+					}
 				}
+
+				_ = unix.Close(fd)
 			}
 		}
 
diff --git a/internal/server/apparmor/instance_forkproxy.go b/internal/server/apparmor/instance_forkproxy.go
index f3775d2df0..b3eb16ebf8 100644
--- a/internal/server/apparmor/instance_forkproxy.go
+++ b/internal/server/apparmor/instance_forkproxy.go
@@ -8,6 +8,7 @@ import (
 	"path/filepath"
 	"slices"
 	"strings"
+	"unicode"
 
 	deviceConfig "github.com/lxc/incus/v7/internal/server/device/config"
 	"github.com/lxc/incus/v7/internal/server/project"
@@ -25,33 +26,51 @@ type device interface {
 
 // forkproxyProfile generates the AppArmor profile template from the given network.
 func forkproxyProfile(sysOS *sys.OS, inst instance, dev device) (string, error) {
-	// Add any socket used by forkproxy.
+	// Add any socket used by forkproxy. Only the host side is a path on this host; resolve it there,
+	// and leave the instance side as configured since it's resolved in the instance's own namespace.
 	sockets := []string{}
 
-	fields := strings.SplitN(dev.Config()["listen"], ":", 2)
-	if fields[0] == "unix" && !strings.HasPrefix(fields[1], "@") {
-		sockets = append(sockets, fields[1])
+	hostField := dev.Config()["connect"]
+	instField := dev.Config()["listen"]
+	bindHost := dev.Config()["bind"] == "" || dev.Config()["bind"] == "host"
+	if bindHost {
+		hostField = dev.Config()["listen"]
+		instField = dev.Config()["connect"]
 	}
 
-	fields = strings.SplitN(dev.Config()["connect"], ":", 2)
-	if fields[0] == "unix" && !strings.HasPrefix(fields[1], "@") {
-		sockets = append(sockets, fields[1])
-	}
+	hostFields := strings.SplitN(hostField, ":", 2)
+	if len(hostFields) == 2 && hostFields[0] == "unix" && !strings.HasPrefix(hostFields[1], "@") {
+		if bindHost {
+			// forkproxy removes and re-binds a host listen socket, so a link at it is never followed; resolve only its directory.
+			dir, err := filepath.EvalSymlinks(filepath.Dir(hostFields[1]))
+			if err != nil {
+				return "", err
+			}
+
+			sockets = append(sockets, filepath.Join(dir, filepath.Base(hostFields[1])))
+		} else if util.PathExists(hostFields[1]) {
+			v, err := filepath.EvalSymlinks(hostFields[1])
+			if err != nil {
+				return "", err
+			}
 
-	// AppArmor requires deref of all paths.
-	for k := range sockets {
-		// Skip non-existing because of the additional entry for the host side.
-		if !util.PathExists(sockets[k]) {
-			continue
+			sockets = append(sockets, v)
+		} else {
+			sockets = append(sockets, hostFields[1])
 		}
+	}
 
-		v, err := filepath.EvalSymlinks(sockets[k])
-		if err != nil {
-			return "", err
+	instFields := strings.SplitN(instField, ":", 2)
+	if len(instFields) == 2 && instFields[0] == "unix" && !strings.HasPrefix(instFields[1], "@") {
+		if !slices.Contains(sockets, instFields[1]) {
+			sockets = append(sockets, instFields[1])
 		}
+	}
 
-		if !slices.Contains(sockets, v) {
-			sockets = append(sockets, v)
+	// A path with AppArmor metacharacters would break out of its rule even when quoted.
+	for _, socket := range sockets {
+		if strings.ContainsFunc(socket, unicode.IsControl) || strings.ContainsAny(socket, "\"\\*?[]{}") {
+			return "", fmt.Errorf("Socket path %q can't be used in an AppArmor profile", socket)
 		}
 	}
 
diff --git a/internal/server/apparmor/instance_forkproxy.profile.go b/internal/server/apparmor/instance_forkproxy.profile.go
index 7efe6768df..785b9df456 100644
--- a/internal/server/apparmor/instance_forkproxy.profile.go
+++ b/internal/server/apparmor/instance_forkproxy.profile.go
@@ -51,7 +51,7 @@ profile "{{ .name }}" flags=(attach_disconnected,mediate_deleted) {
   /{etc,lib,usr/lib}/os-release r,
 {{if .sockets -}}
 {{range $index, $element := .sockets}}
-  {{$element}} rw,
+  "{{$element}}" rw,
 {{- end }}
 {{- end }}
 
