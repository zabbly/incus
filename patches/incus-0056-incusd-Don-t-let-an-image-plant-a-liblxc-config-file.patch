diff --git a/internal/server/instance/lxc.go b/internal/server/instance/lxc.go
new file mode 100644
index 0000000000..70936949d0
--- /dev/null
+++ b/internal/server/instance/lxc.go
@@ -0,0 +1,26 @@
+//go:build linux && cgo
+
+package instance
+
+import (
+	"fmt"
+	"path/filepath"
+
+	liblxc "github.com/lxc/go-lxc"
+
+	"github.com/lxc/incus/v7/shared/util"
+)
+
+// NewLXCContainer returns the go-lxc struct for the named container.
+// On instantiation, liblxc loads <lxcPath>/<name>/config and acts on <lxcPath>/<name>/partial by
+// itself. Incus never creates either, and that directory is the instance volume, so an image could
+// plant them; refuse to hand such a directory to liblxc.
+func NewLXCContainer(name string, lxcPath string) (*liblxc.Container, error) {
+	for _, entry := range []string{"config", "partial"} {
+		if util.PathExists(filepath.Join(lxcPath, name, entry)) {
+			return nil, fmt.Errorf("Unexpected %q entry in the directory of container %q", entry, name)
+		}
+	}
+
+	return liblxc.NewContainer(name, lxcPath)
+}
diff --git a/internal/server/storage/backend.go b/internal/server/storage/backend.go
index 97c41dfed5..33d3ce26d8 100644
--- a/internal/server/storage/backend.go
+++ b/internal/server/storage/backend.go
@@ -755,6 +755,18 @@ func stripMetadata(instPath string) ([]string, error) {
 			return filepath.SkipDir
 		}
 
+		// Remove a top-level "config" or "partial" regular file, which liblxc would load as the
+		// container's configuration. VMs legitimately keep a "config" directory, which is kept below.
+		if d.Type().IsRegular() && (path == filepath.Join(instPath, "config") || path == filepath.Join(instPath, "partial")) {
+			err = os.Remove(path)
+			if err != nil {
+				return err
+			}
+
+			removed = append(removed, path)
+			return nil
+		}
+
 		// Keep directories and regular files.
 		if d.IsDir() || d.Type().IsRegular() {
 			return nil
